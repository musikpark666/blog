---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allPosts = Object.values(import.meta.glob("../posts/*.{md,mdx}", { eager: true }));

  return [
    { params: { category: "dev" }, props: { posts: allPosts } },
    { params: { category: "video" }, props: { posts: allPosts } },
  ];
}

const { category } = Astro.params;
const { posts } = Astro.props;
const filteredPosts = posts.filter((post: any) => post.frontmatter.categories?.includes(category));
---

<BaseLayout title={`${category} ギャラリー | musik.gallery`}>
  <p>Post category is {category}</p>
  <ul>
    {filteredPosts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}
  </ul>
</BaseLayout>