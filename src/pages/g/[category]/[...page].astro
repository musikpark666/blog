---
import GalleryLayout from '../../../components/layouts/GalleryLayout.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { createGalleryPaths, getGalleryHref, type GalleryPageProps } from '../../../lib/gallery';
export const getStaticPaths = (async () => {
  const [galleries, posts] = await Promise.all([getCollection('gallery'), getCollection('post')]);
  return createGalleryPaths(galleries, posts, 'g');
}) satisfies GetStaticPaths;
interface Props extends GalleryPageProps {}
if (Astro.params.page === '1') return Astro.redirect(getGalleryHref(Astro.props.gallery));
---

<GalleryLayout {...Astro.props} />
