---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const [galleryEntries, posts] = await Promise.all([
  getCollection('gallery'),
  getCollection('post'),
]);

const galleries = galleryEntries.sort((a, b) => {
  const yomiA = a.data.yomi || a.data.title;
  const yomiB = b.data.yomi || b.data.title;

  return yomiA.localeCompare(yomiB, 'ja');
});

type GalleryStats = {
  postCount: number;
  latestPost: CollectionEntry<'post'>;
};

const galleryStats = new Map<string, GalleryStats>();

for (const post of posts) {
  for (const category of post.data.categories) {
    const current = galleryStats.get(category.id);

    if (!current) {
      galleryStats.set(category.id, { postCount: 1, latestPost: post });
      continue;
    }

    current.postCount += 1;
    if (post.data.pubDate > current.latestPost.data.pubDate) {
      current.latestPost = post;
    }
  }
}
---

<BaseLayout title="ギャラリー | musik.gallery">
  <section class="gallery-list">
    <header class="page-header">
      <h1 class="visually-hidden">ギャラリー一覧</h1>
      <p>各<span>ギャラリー</span>では、カテゴリー別に記事をまとめて見ることができます。</p>
    </header>

    <hr class="separator" />

    <div class="gallery-grid">
      {galleries.map((gallery, index) => {
        const stats = galleryStats.get(gallery.id);
        const postCount = stats?.postCount ?? 0;

        return (
          <a class="gallery-card" href={`/g/${gallery.id}/`}>
            <div class="gallery-thumbnail">
              <Image
                src={gallery.data.thumbnail}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                widths={[90, 120, 150, 180, 240, 300]}
                sizes="(min-width: 430px) 150px, 90px"
              />
            </div>
            <div class="gallery-card-body">
              <div class="gallery-card-meta">
                <h2>{gallery.data.title}</h2>
                <span class="gallery-card-count">
                  <span class="count-full">{postCount}件の記事</span>
                  <span class="count-short">[{postCount}]</span>
                </span>
              </div>
              <p class="gallery-card-description">{gallery.data.description}</p>
              <p class="gallery-card-latest">
                最近: {stats?.latestPost.data.title ?? '記事はまだありません'}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-list {
    display: grid;
    gap: 4px;
  }

  /* page header */
  .page-header {
    min-width: 0;
  }
  .page-header p {
    margin: 0;
    color: var(--color-text-soft);
    font-size: var(--text-ui);
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .page-header span {
    color: var(--color-link);
  }
  .separator {
    border: none;
    height: 2px;
    background-color: var(--color-brand);
    margin: 0 0 5px 0;
  }

  /* galleries */
  .gallery-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  .gallery-card {
    display: grid;
    grid-template-columns: minmax(90px, 20%) minmax(0, 1fr);
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .gallery-card h2,
  .gallery-card p {
    margin: 0;
  }
  .gallery-card:hover,
  .gallery-card:focus-visible {
    transform: translateY(-2px);
    box-shadow:
      0 10px 24px var(--color-shadow),
      0 2px 8px var(--color-shadow);
  }

  .gallery-thumbnail {
    position: relative;
    align-self: stretch;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--color-surface-muted);
  }
  .gallery-thumbnail :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-card-body {
    display: flex;
    flex-direction: column;
    padding: 0 8px;
    min-width: 0;
  }

  .gallery-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    white-space: nowrap;
  }
  .gallery-card-meta h2 {
    color: var(--color-link);
    font-size: var(--text-list-title);
    line-height: var(--leading-heading);
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .gallery-card-count {
    color: var(--color-muted);
    font-size: var(--text-small);
    white-space: nowrap;
  }
  .count-full {
    display: none;
  }

  .gallery-card-body p {
    margin-top: 2px;
    color: var(--color-secondary);
    font-size: var(--text-ui);
  }
  .gallery-card-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .gallery-card-latest {
    display: none;
  }

  /* Quaries */
  @media (min-width: 430px) {
    .gallery-card {
      grid-template-columns: minmax(120px, 20%) minmax(0, 1fr);
    }

    .count-full {
      display: inline;
    }
    .count-short {
      display: none;
    }

    .gallery-card-body .gallery-card-latest {
      display: block;
      margin-top: auto;
      color: var(--color-heading);
      font-size: var(--text-small);
      font-weight: 700;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
