---
import PostLayout from '../../components/layouts/PostLayout.astro';
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import  { getCollection, render } from 'astro:content';
import { getPostGalleryContexts, groupPostsByGallery } from '../../lib/gallery';
import type { GalleryPostContext } from '../../lib/gallery';

export const getStaticPaths = (async () => {
  const [posts, galleries, minors] = await Promise.all([
    getCollection('post'),
    getCollection('gallery'),
    getCollection('minorGallery'),
  ]);
  const galleriesById = new Map(galleries.map((gallery) => [gallery.id, gallery]));
  const postsByGallery = groupPostsByGallery(posts);
  const minorsById = new Map(minors.map((gallery) => [gallery.id, gallery]));
  const postsByMinor = groupPostsByGallery(posts, 'm');

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, galleryContexts: [
      ...getPostGalleryContexts(post, galleriesById, postsByGallery),
      ...getPostGalleryContexts(post, minorsById, postsByMinor, 'm'),
    ] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'post'>;
  galleryContexts: GalleryPostContext[];
}

const { post, galleryContexts } = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} galleryContexts={galleryContexts} headings={headings}>
  <Content />
</PostLayout>
