---
import BaseLayout from './BaseLayout.astro';
import GalleryHeader from '../components/GalleryHeader.astro';
import GalleryPostList from '../components/GalleryPostList.astro';

import type { CollectionEntry } from 'astro:content';
import type { GalleryPostContext } from '../lib/gallery';

interface Props {
  post: CollectionEntry<'post'>;
  galleryContexts: GalleryPostContext[];
}

const { post, galleryContexts } = Astro.props;
const { pubDate, updDate } = post.data;
const defaultContext = galleryContexts[0];

function formatPostDate(date: Date, showTime = true) {
  return new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: showTime ? '2-digit' : undefined,
    minute: showTime ? '2-digit' : undefined,
    hourCycle: 'h23',
    timeZone: 'Asia/Tokyo',
  }).format(date).replaceAll('/', '.');
}

const formattedPubDate = formatPostDate(pubDate, !updDate);
---

<BaseLayout title={`${post.data.title} | musik.gallery`} description={post.data.description}>
  <div
    data-post-gallery-context
    data-gallery-id={defaultContext?.gallery.id}
  >
    <div data-post-gallery-header>
      {defaultContext && (
        <GalleryHeader gallery={defaultContext.gallery} postCount={defaultContext.postCount} />
      )}
    </div>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <p class="post-dates">
        <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        {updDate && <span>（更新：<time datetime={updDate.toISOString()}>{formatPostDate(updDate)}</time>）</span>}
      </p>
    </header>
    <div class="post-content">
      <slot />
    </div>
    <div data-post-gallery-list>
      {defaultContext && (
        <GalleryPostList
          gallery={defaultContext.gallery}
          posts={defaultContext.pagePosts}
          currentPage={defaultContext.currentPage}
          totalPages={defaultContext.totalPages}
          currentPostId={post.id}
        />
      )}
    </div>

    <!-- Prepare gallery variants only when this post belongs to multiple galleries. -->
    {galleryContexts.length > 1 && galleryContexts.map((context) => (
      <template data-gallery-variant={context.gallery.id}>
        <div data-context-header>
          <GalleryHeader gallery={context.gallery} postCount={context.postCount} />
        </div>
        <div data-context-list>
          <GalleryPostList
            gallery={context.gallery}
            posts={context.pagePosts}
            currentPage={context.currentPage}
            totalPages={context.totalPages}
            currentPostId={post.id}
          />
        </div>
      </template>
    ))}
  </div>
</BaseLayout>

<script>
  function selectPostGallery() {
    const root = document.querySelector<HTMLElement>('[data-post-gallery-context]');
    if (!root) return;

    const templates = Array.from(root.querySelectorAll<HTMLTemplateElement>('template[data-gallery-variant]'));
    const requestedGallery = new URLSearchParams(window.location.search).get('g');
    const selected = templates.find((template) => template.dataset.galleryVariant === requestedGallery) ?? templates[0];
    if (!selected || root.dataset.galleryId === selected.dataset.galleryVariant) return;

    const fragment = selected.content.cloneNode(true) as DocumentFragment;
    const header = fragment.querySelector('[data-context-header]');
    const list = fragment.querySelector('[data-context-list]');
    const headerTarget = root.querySelector('[data-post-gallery-header]');
    const listTarget = root.querySelector('[data-post-gallery-list]');
    if (!header || !list || !headerTarget || !listTarget) return;

    headerTarget.replaceChildren(...header.childNodes);
    listTarget.replaceChildren(...list.childNodes);
    root.dataset.galleryId = selected.dataset.galleryVariant;
  }

  selectPostGallery();
  document.addEventListener('astro:page-load', selectPostGallery);
  window.addEventListener('popstate', selectPostGallery);
</script>

<style>
  /* Post Header */
  .post-header {
    border-bottom: 1px solid #dfe2ee;
    padding-block: 1rem;
  }
  .post-header h1 {
    margin: 0;
    color: #171b30;
    font-size: var(--text-title);
    line-height: var(--leading-heading);
    overflow-wrap: anywhere;
  }
  .post-description {
    margin: 0.5em 0;
    color: #475467;
    font-size: var(--text-ui);
  }
  .post-dates {
    margin: 0;
    color: #667085;
    font-size: var(--text-small);
  }

  .post-content {
    font-size: var(--text-body);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    margin-block: 1.5em 0.5em;
    font-weight: 700;
    line-height: var(--leading-heading);
  }

  .post-content :global(h1),
  .post-content :global(h2) {
    font-size: var(--text-heading);
  }

  .post-content :global(h3) {
    font-size: var(--text-subheading);
  }

  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-size: var(--text-body);
  }

  .post-content :global(p),
  .post-content :global(ul),
  .post-content :global(ol),
  .post-content :global(blockquote) {
    margin-block: 1em;
  }

  .post-content :global(code) {
    font-size: 0.875em;
  }

  .post-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    font-size: var(--text-ui);
    line-height: var(--leading-code);
    padding: 1em;
  }

  .post-content :global(pre code) {
    font-size: inherit;
  }

  .post-content :global(img),
  .post-content :global(video) {
    max-width: 100%;
    height: auto;
  }

  .post-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: var(--text-ui);
  }
</style>
