---
import BaseLayout from './BaseLayout.astro';
import GalleryHeader from '../components/GalleryHeader.astro';
import GalleryPostList from '../components/GalleryPostList.astro';
import TableOfContents from '../components/TableOfContents.astro';

import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import type { GalleryPostContext } from '../lib/gallery';

interface Props {
  post: CollectionEntry<'post'>;
  galleryContexts: GalleryPostContext[];
  headings: MarkdownHeading[];
}

const { post, galleryContexts, headings } = Astro.props;
const tocHeadings = headings.filter(
  ({ depth }) => depth === 2 || depth === 3
);
const { pubDate, updDate } = post.data;
const defaultContext = galleryContexts[0];

function formatPostDate(date: Date, showTime = true) {
  return new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: showTime ? '2-digit' : undefined,
    minute: showTime ? '2-digit' : undefined,
    hourCycle: 'h23',
    timeZone: 'Asia/Tokyo',
  }).format(date).replaceAll('/', '.');
}

const formattedPubDate = formatPostDate(pubDate, !updDate);
---

<BaseLayout title={`${post.data.title} | musik.gallery`} description={post.data.description}>
  <TableOfContents slot="left" title={post.data.title} headings={tocHeadings} />
  <div
    data-post-gallery-context
    data-gallery-id={defaultContext?.gallery.id}
  >
    <div data-post-gallery-header>
      {defaultContext && (
        <GalleryHeader gallery={defaultContext.gallery} postCount={defaultContext.postCount} />
      )}
    </div>
    <header class="post-header">
      <h1 id="post-title">{post.data.title}</h1>
      <p class="post-description">{post.data.description}</p>
      <p class="post-dates">
        <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        {updDate && <span>（更新：<time datetime={updDate.toISOString()}>{formatPostDate(updDate)}</time>）</span>}
      </p>
    </header>
    {tocHeadings.length > 0 && (
      <div class="post-toc">
        <TableOfContents title={post.data.title} headings={tocHeadings} compact />
      </div>
    )}
    <div class="post-content">
      <slot />
    </div>
    <div data-post-gallery-list>
      {defaultContext && (
        <GalleryPostList
          gallery={defaultContext.gallery}
          posts={defaultContext.pagePosts}
          currentPage={defaultContext.currentPage}
          totalPages={defaultContext.totalPages}
          currentPostId={post.id}
        />
      )}
    </div>

    <!-- Prepare gallery variants only when this post belongs to multiple galleries. -->
    {galleryContexts.length > 1 && galleryContexts.map((context) => (
      <template data-gallery-variant={context.gallery.id}>
        <div data-context-header>
          <GalleryHeader gallery={context.gallery} postCount={context.postCount} />
        </div>
        <div data-context-list>
          <GalleryPostList
            gallery={context.gallery}
            posts={context.pagePosts}
            currentPage={context.currentPage}
            totalPages={context.totalPages}
            currentPostId={post.id}
          />
        </div>
      </template>
    ))}
  </div>
</BaseLayout>

<script>
  function selectPostGallery() {
    const root = document.querySelector<HTMLElement>('[data-post-gallery-context]');
    if (!root) return;

    const templates = Array.from(root.querySelectorAll<HTMLTemplateElement>('template[data-gallery-variant]'));
    const requestedGallery = new URLSearchParams(window.location.search).get('g');
    const selected = templates.find((template) => template.dataset.galleryVariant === requestedGallery) ?? templates[0];
    if (!selected || root.dataset.galleryId === selected.dataset.galleryVariant) return;

    const fragment = selected.content.cloneNode(true) as DocumentFragment;
    const header = fragment.querySelector('[data-context-header]');
    const list = fragment.querySelector('[data-context-list]');
    const headerTarget = root.querySelector('[data-post-gallery-header]');
    const listTarget = root.querySelector('[data-post-gallery-list]');
    if (!header || !list || !headerTarget || !listTarget) return;

    headerTarget.replaceChildren(...header.childNodes);
    listTarget.replaceChildren(...list.childNodes);
    root.dataset.galleryId = selected.dataset.galleryVariant;
  }

  selectPostGallery();
  document.addEventListener('astro:page-load', selectPostGallery);
  window.addEventListener('popstate', selectPostGallery);

  function revealFootnotes(hash: string, scroll = false) {
    let id: string;
    try {
      id = decodeURIComponent(hash.slice(1));
    } catch {
      return;
    }
    const target = document.getElementById(id);
    const panel = target?.closest<HTMLDetailsElement>('.footnotes details');
    if (!panel) return;
    panel.open = true;
    if (scroll) target!.scrollIntoView();
  }

  // Open before native anchor navigation, including repeated clicks on the same hash.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element) || event.button !== 0 ||
      event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href^="#"]');
    if (link) revealFootnotes(link.hash);
  });
  const revealLinkedFootnote = () => revealFootnotes(window.location.hash, true);
  revealLinkedFootnote();
  window.addEventListener('hashchange', revealLinkedFootnote);
  document.addEventListener('astro:page-load', revealLinkedFootnote);
</script>

<style is:global>
  @import 'rehype-callouts/theme/obsidian';
</style>

<style>
  .post-toc {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-block: 0.75rem;
  }

  @media (min-width: 1460px) {
    .post-toc {
      display: none;
    }
  }

  /* Post Header */
  .post-header {
    border-bottom: 1px solid #dfe2ee;
    padding: .75rem 0 .5rem 0;
  }
  .post-header h1 {
    margin: 0;
    color: #171b30;
    font-size: var(--text-title);
    line-height: var(--leading-heading);
    font-weight: 600;
    overflow-wrap: anywhere;
    scroll-margin-top: 4rem;
  }
  .post-description {
    margin: 0.25em 0;
    color: #475467;
    font-size: var(--text-ui);
  }
  .post-dates {
    margin: 0;
    color: #667085;
    font-size: var(--text-small);
  }

  /* Post Content */
  .post-content {
    display: flow-root;
    margin-bottom: 3rem;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
  }

  .post-content :global(a) {
    color: var(--dc-color-2);
    text-underline-offset: 0.15em;
  }
  .post-content :global(a:visited) {
    color: #6b46a3;
  }
  .post-content :global(a:hover) {
    color: var(--dc-color-1);
  }
  .post-content :global(a:focus-visible) {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 2px;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    clear: both;
    margin-block: 1.5em 0.5em;
    font-weight: 600;
    line-height: var(--leading-heading);
    scroll-margin-top: 4rem;
  }

  .post-content :global(h2) {
    font-size: var(--text-heading);
    padding-block-end: 0.35em;
    border-bottom: 1px solid #cfd4e4;
  }
  .post-content :global(h3) {
    font-size: var(--text-subheading);
    padding-block-end: 0.35em;
    border-bottom: 1px solid #e1e4ec;
  }
  .post-content :global(h2::before),
  .post-content :global(h3::before) {
    margin-inline-end: 0.4em;
    color: var(--dc-color-2);
    font-family: var(--font-code);
  }
  .post-content :global(h2::before) {
    content: '#';
  }
  .post-content :global(h3::before) {
    content: '##';
  }
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-size: var(--text-body);
  }

  .post-content :global(p),
  .post-content :global(ul),
  .post-content :global(ol),
  .post-content :global(blockquote) {
    margin-block: 1em;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-inline-start: 1.5em;
  }

  .post-content :global(li > ul),
  .post-content :global(li > ol) {
    margin-block: 0.25em;
  }

  .post-content :global(li > p) {
    margin-block: 0.25em;
  }

  .post-content :global(li > p + p) {
    margin-block-start: 0.5em;
  }

  .post-content :global(blockquote[data-greentext]) {
    margin-inline: 0;
    color: #4c6b23;
  }
  .post-content :global(.greentext-line) {
    display: block;
    position: relative;
    padding-inline-start: 1.1em;
  }
  .post-content :global(.greentext-line::before) {
    position: absolute;
    inset-inline-start: 0;
    content: '>';
    font-family: var(--font-code);
  }

  /* Use the plugin's structure and icons with the blog's typography. */
  .post-content :global(.callout) {
    --rc-color-light: var(--dc-color-2);

    padding: 0.75rem;
    border-inline-start: 3px solid var(--rc-color-light, #667085);
    border-radius: 2px;
    line-height: inherit;
    mix-blend-mode: normal;
  }
  .post-content :global(.callout:is([data-callout='abstract'], [data-callout='summary'], [data-callout='tldr'], [data-callout='tip'], [data-callout='hint'], [data-callout='important'], [data-callout='success'], [data-callout='check'], [data-callout='done'])) {
    --rc-color-light: #24756a;
  }
  .post-content :global(.callout:is([data-callout='question'], [data-callout='help'], [data-callout='faq'], [data-callout='warning'], [data-callout='attention'], [data-callout='caution'])) {
    --rc-color-light: #945a16;
  }
  .post-content :global(.callout:is([data-callout='failure'], [data-callout='missing'], [data-callout='fail'], [data-callout='danger'], [data-callout='error'], [data-callout='bug'])) {
    --rc-color-light: #b8324a;
  }
  .post-content :global(.callout[data-callout='example']) {
    --rc-color-light: #6b46a3;
  }
  .post-content :global(.callout:is([data-callout='quote'], [data-callout='cite'])) {
    --rc-color-light: #59636f;
  }
  .post-content :global(.callout-title) {
    align-items: baseline;
    gap: 0.5rem;
    line-height: var(--leading-ui);
  }
  .post-content :global(.callout-title-text) {
    min-width: 0;
    flex: 1;
  }
  .post-content :global(.callout-title-icon),
  .post-content :global(.callout-fold-icon) {
    align-self: center;
  }
  .post-content :global(summary.callout-title:focus-visible) {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 3px;
  }
  .post-content :global(.callout-content > :first-child) {
    margin-block-start: 0.5em;
  }
  .post-content :global(.callout-content > :last-child) {
    margin-block-end: 0;
  }

  .post-content :global(a[data-footnote-ref]),
  .post-content :global(a[data-footnote-backref]) {
    color: var(--dc-color-2);
    text-decoration: none;
    white-space: nowrap;
    scroll-margin-top: 4rem;
  }
  .post-content :global(a[data-footnote-ref]:hover),
  .post-content :global(a[data-footnote-backref]:hover) {
    text-decoration: underline;
  }
  .post-content :global(a[data-footnote-ref]:focus-visible),
  .post-content :global(a[data-footnote-backref]:focus-visible) {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 2px;
  }
  .post-content :global(.footnotes) {
    margin-block: 1.5em 0.5em;
  }
  .post-content :global(.footnotes summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em;
    padding-block-end: 0.35em;
    border-bottom: 1px solid #cfd4e4;
    cursor: pointer;
    list-style: none;
  }
  .post-content :global(.footnotes summary::-webkit-details-marker) {
    display: none;
  }
  .post-content :global(.footnotes summary::after) {
    content: '▸';
    color: var(--dc-color-2);
  }
  .post-content :global(.footnotes details[open] > summary::after) {
    content: '▾';
  }
  .post-content :global(.footnotes summary h2) {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .post-content :global(.footnotes summary:hover) {
    color: var(--dc-color-2);
  }
  .post-content :global(.footnotes summary:focus-visible) {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 3px;
  }
  .post-content :global(.footnotes > details > ol) {
    font-size: var(--text-ui);
    list-style: none;
    padding-inline-start: 0;
  }
  .post-content :global(.footnotes > details > ol > li) {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    column-gap: 0.6em;
    margin-block: 0.75em;
    scroll-margin-top: 4rem;
  }
  .post-content :global(.footnote-number) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-variant-numeric: tabular-nums;
  }
  .post-content :global(.footnote-content > :first-child) {
    margin-block-start: 0;
  }
  .post-content :global(.footnote-content > :last-child) {
    margin-block-end: 0;
  }

  .post-content :global(code:not(pre code)),
  .post-content :global(kbd:not(pre kbd)),
  .post-content :global(samp:not(pre samp)) {
    font-size: 0.875em;
    padding: 0.08em 0.35em;
    border: 1px solid #30363d;
    border-radius: 3px;
    background-color: #24292e;
    color: #e6edf3;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .post-content :global(code:not(pre code)) {
    vertical-align: 0.05em;
    border-color: #e1e4e8;
    background-color: #f3f4f6;
    color: #b8324a;
  }
  .post-content :global(kbd:not(pre kbd)) {
    display: inline-block;
    padding-inline: 0.45em;
    line-height: var(--leading-ui);
    white-space: nowrap;
    box-shadow: inset 0 -2px 0 #161b22;
  }
  /* Expressive Code controls the font, padding and scrolling of its own blocks. */
  .post-content :global(pre:not(.expressive-code pre)) {
    max-width: 100%;
    overflow-x: auto;
    font-size: var(--text-ui);
    line-height: var(--leading-code);
    padding: 1em;
  }
  .post-content :global(pre:not(.expressive-code pre) code) {
    font-size: inherit;
  }

  .post-content :global(.expressive-code) {
    margin-block: 1em;
    min-width: 0;
  }

  .post-content :global(img),
  .post-content :global(video) {
    max-width: 100%;
    height: auto;
  }

  .post-content :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: var(--text-ui);
  }

  .post-content :global(strong) {
    font-weight: 700;
  }
  .post-content :global(mark) {
    background: linear-gradient(transparent 60%, #ff6 60%);
  }
</style>
