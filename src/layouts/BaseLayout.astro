---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Content from '../components/Content.astro';
import Footer from '../components/Footer.astro';
import AgeGate from '../components/AgeGate.astro';

interface Props {
  title: string;
  description?: string;
};

const {
  title,
  description = '朴武識のブログ',
} = Astro.props;
---

<html lang="ja" data-age-pending>
  <head>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon/favicon-96x96.png?v=20261014-2" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg?v=20261014-2" />
    <link rel="shortcut icon" href="/favicon/favicon.ico?v=20261014-2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png?v=20261014-2" />
    <meta name="apple-mobile-web-app-title" content="musik" />
    <link rel="manifest" href="/favicon/site.webmanifest?v=20261014-2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-pretendard-jp" />
  </head>
  <body>
    <AgeGate />
    <Header />
    <Content>
      <slot name="left" slot="left" />
      <slot />
    </Content>
    <Footer />
    <div class="page-scroll" role="group" aria-label="ページ内の移動">
      <slot name="page-controls" />
      <div class="page-scroll-arrows">
        <button type="button" data-page-scroll="top" aria-label="ページの先頭へ" title="ページの先頭へ">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 4h14M6 13l6-6 6 6M12 7v13" />
          </svg>
        </button>
        <button type="button" data-page-scroll="bottom" aria-label="ページの末尾へ" title="ページの末尾へ">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 20h14M6 11l6 6 6-6M12 17V4" />
          </svg>
        </button>
      </div>
    </div>
  </body>
</html>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-page-scroll]');
    if (!button) return;
    window.scrollTo({
      top: button.dataset.pageScroll === 'top' ? 0 : document.documentElement.scrollHeight,
      behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    });
  });
</script>

<style>
  .page-scroll {
    --button-size: 2.75rem;
    position: fixed;
    /* Stay 12px outside the centered content when there is enough side space. */
    right: max(12px, calc((100% - var(--layout-max-width)) / 2 - var(--button-size) - 14px), env(safe-area-inset-right));
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 10;
    display: grid;
    gap: 8px;
    color: var(--dc-color-2);
    opacity: 0.6;
  }
  .page-scroll-arrows {
    border: 1px solid #cfd4e4;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 2px 8px #171b3026;
  }
  .page-scroll button {
    display: grid;
    place-items: center;
    width: var(--button-size);
    height: var(--button-size);
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .page-scroll button + button { border-top: 1px solid #cfd4e4; }
  .page-scroll button:hover,
  .page-scroll button:focus-visible {
    background: #eef0f8;
    color: var(--dc-color-1);
  }
  .page-scroll button:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: -3px;
  }
  .page-scroll:hover,
  .page-scroll:focus-within,
  .page-scroll:has(:global(details[open])) { opacity: 1; }
  @media (min-width: 768px) {
    .page-scroll {
      bottom: max(24px, env(safe-area-inset-bottom));
      opacity: 1;
    }
  }
  @media print {
    .page-scroll { display: none; }
  }
</style>
