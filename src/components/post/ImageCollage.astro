---
import Img from './Img.astro';
import type { PostImage } from '../../lib/post-images';

interface Props {
  images: PostImage[];
  mode?: 'mosaic' | 'carousel';
  columns?: 2 | 3;
  label?: string;
}
const { images, mode = 'mosaic', columns = 2, label = '画像ギャラリー' } = Astro.props;
if (!images.length) throw new Error('<ImageCollage>: images must contain at least one image.');
const carousel = mode === 'carousel';
---

<image-collage class="post-image-collage" data-mode={mode} data-columns={columns}>
  <div class="collage-track" tabindex={carousel ? 0 : undefined}
    role={carousel ? 'region' : 'group'} aria-label={label}
    aria-description={carousel ? '左右の矢印キーで画像を切り替えられます。' : undefined}>
    {images.map((image, index) => (
      <div class="collage-item" role={carousel ? 'group' : undefined}
        aria-label={carousel ? `${index + 1} / ${images.length}` : undefined}>
        <Img {...image} sizes={carousel
          ? '(min-width: 768px) 640px, calc(100vw - 24px)'
          : `(min-width: 640px) ${Math.ceil(720 / columns)}px, (min-width: 480px) 50vw, calc(100vw - 24px)`} />
      </div>
    ))}
  </div>
  {carousel && images.length > 1 && (
    <div class="collage-controls" hidden>
      <button type="button" data-direction="-1" aria-label="前の画像">←</button>
      <span class="collage-count" aria-live="polite" aria-atomic="true">1 / {images.length}</span>
      <button type="button" data-direction="1" aria-label="次の画像">→</button>
    </div>
  )}
</image-collage>

<script>
  class ImageCollage extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.collage-track');
      const controls = this.querySelector<HTMLElement>('.collage-controls');
      if (!track || !controls || this.cleanup) return;
      const items = Array.from(track.children) as HTMLElement[];
      const buttons = Array.from(controls.querySelectorAll<HTMLButtonElement>('button'));
      const count = controls.querySelector<HTMLElement>('.collage-count')!;
      const controller = new AbortController();
      let current = 0;
      const update = () => {
        const left = track.getBoundingClientRect().left;
        current = items.reduce((nearest, item, index) =>
          Math.abs(item.getBoundingClientRect().left - left) <
          Math.abs(items[nearest].getBoundingClientRect().left - left) ? index : nearest, 0);
        count.textContent = `${current + 1} / ${items.length}`;
        buttons[0].disabled = current === 0;
        buttons[1].disabled = current === items.length - 1;
      };
      const moveTo = (index: number) => {
        current = Math.max(0, Math.min(items.length - 1, index));
        const target = items[current];
        track.scrollBy({
          left: target.getBoundingClientRect().left - track.getBoundingClientRect().left,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
        });
      };
      controls.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button');
        if (button) moveTo(current + Number(button.dataset.direction));
      }, { signal: controller.signal });
      track.addEventListener('keydown', (event) => {
        if (event.target !== track || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        moveTo(event.key === 'Home' ? 0 : event.key === 'End' ? items.length - 1 :
          current + (event.key === 'ArrowRight' ? 1 : -1));
      }, { signal: controller.signal });
      // Announce the settled image, rather than every frame of a swipe.
      track.addEventListener('scrollend', update, { signal: controller.signal });
      const observer = new ResizeObserver(update);
      observer.observe(track);
      controls.hidden = false;
      update();
      this.cleanup = () => { controller.abort(); observer.disconnect(); };
    }

    disconnectedCallback() { this.cleanup?.(); this.cleanup = undefined; }
  }
  if (!customElements.get('image-collage')) customElements.define('image-collage', ImageCollage);
</script>

<style>
  .post-image-collage { display: block; clear: both; min-width: 0; margin-block: 1.25em; }
  .collage-track { display: grid; gap: 0.75rem; }
  .collage-item { min-width: 0; }
  .post-image-collage :global(.post-image) { margin-block: 0; }
  [data-mode='carousel'] .collage-track {
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    padding-block-end: 0.5rem;
  }
  [data-mode='carousel'] .collage-item { scroll-snap-align: start; }
  .collage-track:focus-visible { outline: 2px solid var(--dc-color-2); outline-offset: 3px; }
  .collage-controls { display: flex; justify-content: center; align-items: center; gap: 0.75rem; margin-block-start: 0.5rem; }
  .collage-controls[hidden] { display: none; }
  .collage-controls button {
    width: 2.25rem;
    height: 2rem;
    border: 1px solid #cfd4df;
    border-radius: 2px;
    background: #f8f9fc;
    color: var(--dc-color-2);
    font: inherit;
    cursor: pointer;
  }
  .collage-controls button:hover:enabled { background: #e9ecf8; }
  .collage-controls button:focus-visible { outline: 2px solid var(--dc-color-2); outline-offset: 2px; }
  .collage-controls button:disabled { opacity: 0.4; cursor: default; }
  .collage-count { font-size: var(--text-ui); color: #475467; font-variant-numeric: tabular-nums; }
  @media (min-width: 480px) {
    [data-mode='mosaic'] .collage-track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 640px) {
    [data-mode='mosaic'][data-columns='3'] .collage-track { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
