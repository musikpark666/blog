---
import { Image } from 'astro:assets';
import { resolvePostImage, renderImageText, registerPostImage, type PostImage } from '../../lib/post-images';

interface Props extends PostImage {
  align?: 'left' | 'center' | 'right';
  float?: 'left' | 'right';
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', caption, source, width, height, align = 'left', float,
  sizes, loading = 'lazy', quality = 60, spoiler = false } = Astro.props;
const pendingImage = resolvePostImage(src);
registerPostImage(Astro.locals, pendingImage);
const image = await pendingImage;
if (typeof image === 'string' && (!width || !height)) {
  throw new Error('<Img>: public/ and remote images require width and height to reserve their aspect ratio.');
}
const intrinsicWidth = typeof image === 'string' ? width! : image.width;
const intrinsicHeight = typeof image === 'string' ? height! : image.height;
const displayWidth = Math.min(width ?? (float ? 320 : 640), intrinsicWidth);
const displayHeight = Math.max(1, Math.round(displayWidth * intrinsicHeight / intrinsicWidth));
const maxWidth = Math.min(intrinsicWidth, displayWidth * 2);
const widths = [...new Set([320, 640, 960, displayWidth, maxWidth])]
  .filter((value) => value <= maxWidth).sort((a, b) => a - b);
const [captionHtml, sourceHtml] = await Promise.all([renderImageText(caption), renderImageText(source)]);
// Preserve compressed AVIFs, vector images, and GIF animation without re-encoding.
const preserveOriginal = typeof image === 'string'
  ? /\.(avif|svg|gif)(?:[?#]|$)/i.test(image)
  : ['avif', 'svg', 'gif'].includes(image.format);
---

<figure class="post-image" data-align={align} data-float={float}
  data-spoiler-hidden={spoiler ? '' : undefined} style={`--image-width: ${displayWidth}px`}>
  <div class="post-image-visual">
    {preserveOriginal ? (
      <img src={typeof image === 'string' ? image : image.src} alt={alt}
        width={intrinsicWidth} height={intrinsicHeight} loading={loading} decoding="async"
        aria-hidden={spoiler ? 'true' : undefined} />
    ) : (
      <Image src={image} alt={alt} width={displayWidth} height={displayHeight}
        widths={widths} sizes={sizes ?? `(min-width: ${displayWidth + 24}px) ${displayWidth}px, calc(100vw - 24px)`}
        format="avif" quality={quality} loading={loading} decoding="async"
        aria-hidden={spoiler ? 'true' : undefined} />
    )}
    {spoiler && (
      <button type="button" class="post-image-spoiler" aria-label="注意が必要な画像を表示" title="画像を表示">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
          aria-hidden="true" focusable="false">
          <path d="M12 3 2 21h20L12 3Z" />
          <path d="M12 9v5" />
          <circle cx="12" cy="17.5" r="0.9" fill="currentColor" stroke="none" />
        </svg>
      </button>
    )}
    {sourceHtml && (
      <details class="post-image-source">
        <summary aria-label="画像の出典情報" title="出典情報">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
            aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v6" />
            <circle cx="12" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
          </svg>
        </summary>
        <div class="post-image-source-content" set:html={sourceHtml} />
      </details>
    )}
  </div>
  {captionHtml && <figcaption class="post-image-caption" set:html={captionHtml} />}
</figure>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('.post-image-spoiler');
    if (!button) return;
    const figure = button.closest<HTMLElement>('.post-image')!;
    const image = figure.querySelector('img')!;
    figure.removeAttribute('data-spoiler-hidden');
    image.removeAttribute('aria-hidden');
    if (document.activeElement === button) {
      image.tabIndex = -1;
      image.focus({ preventScroll: true });
    }
    button.remove();
  });
</script>

<style>
  .post-image {
    width: min(100%, var(--image-width));
    min-width: 0;
    margin: 1.25em auto;
  }
  .post-image[data-align='left'] { margin-inline: 0 auto; }
  .post-image[data-align='right'] { margin-inline: auto 0; }
  .post-image-visual { position: relative; }
  .post-image-visual :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .post-image[data-spoiler-hidden] .post-image-visual :global(img) {
    filter: blur(20px);
    clip-path: inset(0);
  }
  .post-image-spoiler {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: #ffdf5d;
    cursor: pointer;
  }
  .post-image-spoiler svg {
    filter: drop-shadow(0 0 1px #171b30) drop-shadow(0 1px 3px #171b30cc);
  }
  .post-image-spoiler:hover,
  .post-image-spoiler:focus-visible { color: #fff2a8; }
  .post-image-spoiler:focus-visible {
    outline: 2px solid #ffdf5d;
    outline-offset: -2px;
  }
  .post-image-caption {
    margin-block-start: 0.5rem;
    color: #475467;
    font-size: var(--text-ui);
    line-height: var(--leading-body);
    text-align: center;
  }
  /* Override the article's paragraph margins inside image annotations. */
  .post-image :global(.post-image-caption > :first-child),
  .post-image :global(.post-image-source-content > :first-child) { margin-block-start: 0; }
  .post-image :global(.post-image-caption > :last-child),
  .post-image :global(.post-image-source-content > :last-child) { margin-block-end: 0; }

  .post-image-source {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .post-image-source summary {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-end: 0.5rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: transparent;
    color: var(--dc-color-2);
    padding: 0;
    line-height: 1;
    list-style: none;
    cursor: pointer;
    pointer-events: auto;
  }
  .post-image-source summary svg { display: block; }
  .post-image-source summary::-webkit-details-marker { display: none; }
  .post-image-source summary:hover,
  .post-image-source[open] summary { background: #e9ecf8; }
  .post-image-source summary:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 2px;
  }
  .post-image-source-content {
    position: absolute;
    inset-block-start: 3rem;
    inset-inline-end: 0.5rem;
    z-index: 2;
    width: min(22rem, calc(100% - 1rem));
    max-height: max(4rem, min(18rem, 50vh, calc(100% - 3.5rem)));
    overflow: auto;
    padding: 0.75rem;
    border: 1px solid #cfd4e4;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 3px 12px #171b3026;
    color: #475467;
    font-size: var(--text-ui);
    line-height: var(--leading-body);
    text-align: start;
    pointer-events: auto;
  }
  @media (min-width: 640px) {
    .post-image[data-float] {
      width: min(var(--image-width), 45%);
      margin-block: 0.25em 0.75em;
    }
    .post-image[data-float='left'] { float: left; margin-inline: 0 1.25em; }
    .post-image[data-float='right'] { float: right; margin-inline: 1.25em 0; }
  }
</style>
