---
import Social from './Social.astro';
import profileImage from '../assets/imgs/profile cat foil.avif';
---

<div class="sidebar-about">
  <div class="my-info">
    <a class="info-avatar-link" href="/about/" aria-label="ムシクの紹介">
      <img
        class="info-avatar"
        src={profileImage.src}
        alt="ムシクのプロフィール画像"
        width="72"
        height="72"
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="info-text">
      <a class="info-name" href="/about/">
        <span><strong>ムシク</strong>ちゃん</span>
      </a>
      <p class="info-description">猫は泣かないっていうけど、私は何なんだろう。</p>
    </div>
  </div>
  <div class="social">
    <Social />
  </div>
</div>

<section class="sidebar-item sidebar-recent" >
  <div class="sidebar-item-header">
    <h2><a href="/all/">最近の投稿</a></h2>
  </div>
  <div class="sidebar-item-recent">
    - 投稿 3
    - 投稿 2
    - 投稿 1
  </div>
</section>

<section class="sidebar-item sidebar-galleries">
  <div class="sidebar-item-header">
    <h2><a href="/g/">ギャラリーリスト</a></h2>
  </div>
  <div class="sidebar-item-list">
    - ギャラリー 1
    - ギャラリー 2
    - ギャラリー 3
    - ギャラリー 4
  </div>
</section>

<section class="sidebar-item">
  <div class="sidebar-item-header">
    <h2>名言</h2>
  </div>
  <div class="sidebar-item-">
    blah blah...
  </div>
</section>

<section class="sidebar-item">
  <div class="sidebar-item-header">
    <h2>ニュース</h2>
  </div>
  <div class="sidebar-item-">
    blah blah...
  </div>
</section>

<style>
  /* about widget */
  .sidebar-about {
    border: 1px solid var(--dc-color-2);
    margin-bottom: 12px;
  }
  .my-info {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    padding: 12px;
  }
  .info-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }
  .info-avatar-link {
    display: block;
    border-radius: 50%;
  }
  .info-avatar-link:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 3px;
  }
  .info-avatar {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }
  .info-name {
    font-size: var(--text-list-title);
    color: var(--dc-color-2);
    text-decoration: none;
  }
  .info-description {
    margin: 0;
    min-width: 0;
    color: #475467;
    font-size: var(--text-ui);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
  }
  .info-name:hover,
  .info-name:focus-visible {
    color: var(--dc-color-1);
    text-decoration: underline;
  }
  .info-name:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    min-height: 2.25rem;
    background-color: #f3f3f3;
  }

  /* batch styles */
  .sidebar-item {
    padding: 12px 12px;
    margin-bottom: 12px;
    border: 1px solid #ccc;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .sidebar-item-header {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-left: 2px;
    border-bottom: 1px dashed #aaa;
  }
  .sidebar-item-header h2 {
    font-size: var(--text-ui);
    line-height: var(--leading-heading);
    margin: 0;
    font-weight: 700;
  }
  .sidebar-item-header a {
    color: #333;
    text-decoration: none;
  }
  .sidebar-item-header a:hover {
    color: var(--dc-color-2);
  }
</style>
