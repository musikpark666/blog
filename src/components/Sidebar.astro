---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Social from './Social.astro';
import profileImage from '../assets/imgs/profile cat foil.avif';
import missingPostImage from '../assets/imgs/missing-image-mustbechange.avif';

const [postEntries, galleryEntries] = await Promise.all([
  getCollection('post'),
  getCollection('gallery'),
]);

const recentPostsPerPage = 6;
const recentPosts = postEntries
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.id.localeCompare(b.id))
  .slice(0, recentPostsPerPage * 5);
const recentPages = Array.from(
  { length: Math.max(1, Math.ceil(recentPosts.length / recentPostsPerPage)) },
  (_, index) => recentPosts.slice(index * recentPostsPerPage, (index + 1) * recentPostsPerPage),
);

const galleries = galleryEntries.sort((a, b) => {
  const yomiA = a.data.yomi || a.data.title;
  const yomiB = b.data.yomi || b.data.title;
  return yomiA.localeCompare(yomiB, 'ja');
});
const galleriesPerPage = 14;
const galleryPages = Array.from(
  { length: Math.max(1, Math.ceil(galleries.length / galleriesPerPage)) },
  (_, index) => galleries.slice(index * galleriesPerPage, (index + 1) * galleriesPerPage),
);
---

<div class="sidebar-about">
  <div class="my-info">
    <a class="info-avatar-link" href="/about/" aria-label="ムシクの紹介">
      <img
        class="info-avatar"
        src={profileImage.src}
        alt="ムシクのプロフィール画像"
        width="72"
        height="72"
        loading="lazy"
        decoding="async"
      />
    </a>
    <div class="info-text">
      <a class="info-name" href="/about/">
        <span><strong>ムシク</strong>ちゃん</span>
      </a>
      <p class="info-description">猫は泣かないっていうけど、私は何なんだろう。</p>
    </div>
  </div>
  <div class="social">
    <Social />
  </div>
</div>

<sidebar-pager>
  <section class="sidebar-item sidebar-recent" aria-label="最近の投稿">
    <div class="sidebar-item-header">
      <h2><a href="/all/">最近の投稿</a></h2>
      {recentPages.length > 1 && (
        <div class="sidebar-pagination" data-sidebar-controls hidden>
          <span data-sidebar-counter aria-live="polite" aria-atomic="true">1/{recentPages.length}</span>
          <div class="sidebar-pagination-buttons">
            <button type="button" data-sidebar-prev aria-label="最近の投稿の前のページ" disabled>
              <svg width="10" height="14" viewBox="0 0 10 14" aria-hidden="true"><path d="M8 1 2 7l6 6Z" fill="currentColor" /></svg>
            </button>
            <button type="button" data-sidebar-next aria-label="最近の投稿の次のページ">
              <svg width="10" height="14" viewBox="0 0 10 14" aria-hidden="true"><path d="m2 1 6 6-6 6Z" fill="currentColor" /></svg>
            </button>
          </div>
        </div>
      )}
    </div>
    {recentPages.map((posts, pageIndex) => (
      <div class="sidebar-page" data-sidebar-page hidden={pageIndex !== 0}>
        <ul class="recent-featured" role="list">
          {posts.slice(0, 2).map((post) => (
            <li>
              <a href={`/posts/${post.id}/`} title={post.data.title}>
                <Image
                  src={post.data.image ?? missingPostImage}
                  alt=""
                  width={132}
                  height={99}
                  widths={[132, 264]}
                  sizes="(min-width: 992px) 132px, 112px"
                  fit="cover"
                  format="avif"
                  quality={60}
                  loading="lazy"
                  decoding="async"
                />
                <span>{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="sidebar-list" role="list">
          {posts.slice(2).map((post) => (
            <li><a href={`/posts/${post.id}/`} title={post.data.title}>{post.data.title}</a></li>
          ))}
        </ul>
        {posts.length === 0 && <p class="sidebar-empty">投稿はまだありません。</p>}
      </div>
    ))}
  </section>
</sidebar-pager>

<sidebar-pager>
  <section class="sidebar-item sidebar-galleries" aria-label="ギャラリーリスト">
    <div class="sidebar-item-header">
      <h2><a href="/g/">ギャラリーリスト</a></h2>
      {galleryPages.length > 1 && (
        <div class="sidebar-pagination" data-sidebar-controls hidden>
          <span data-sidebar-counter aria-live="polite" aria-atomic="true">1/{galleryPages.length}</span>
          <div class="sidebar-pagination-buttons">
            <button type="button" data-sidebar-prev aria-label="ギャラリーリストの前のページ" disabled>
              <svg width="10" height="14" viewBox="0 0 10 14" aria-hidden="true"><path d="M8 1 2 7l6 6Z" fill="currentColor" /></svg>
            </button>
            <button type="button" data-sidebar-next aria-label="ギャラリーリストの次のページ">
              <svg width="10" height="14" viewBox="0 0 10 14" aria-hidden="true"><path d="m2 1 6 6-6 6Z" fill="currentColor" /></svg>
            </button>
          </div>
        </div>
      )}
    </div>
    {galleryPages.map((entries, pageIndex) => (
      <div class="sidebar-page" data-sidebar-page hidden={pageIndex !== 0}>
        <ul class="sidebar-list" role="list" style={`--gallery-rows: ${Math.max(1, Math.ceil(entries.length / 2))}`}>
          {entries.map((gallery) => (
            <li><a href={`/g/${gallery.id}/`} title={gallery.data.title}>{gallery.data.title}</a></li>
          ))}
        </ul>
        {entries.length === 0 && <p class="sidebar-empty">ギャラリーはまだありません。</p>}
      </div>
    ))}
  </section>
</sidebar-pager>

<section class="sidebar-item">
  <div class="sidebar-item-header">
    <h2>名言</h2>
  </div>
  <div class="sidebar-item-">
    blah blah...
  </div>
</section>

<!-- <section class="sidebar-item">
  <div class="sidebar-item-header">
    <h2>ニュース</h2>
  </div>
  <div class="sidebar-item-">
    blah blah...
  </div>
</section> -->

<script>
  class SidebarPager extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      const pages = Array.from(this.querySelectorAll<HTMLElement>('[data-sidebar-page]'));
      const controls = this.querySelector<HTMLElement>('[data-sidebar-controls]');
      const counter = this.querySelector<HTMLElement>('[data-sidebar-counter]');
      const previous = this.querySelector<HTMLButtonElement>('[data-sidebar-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-sidebar-next]');
      if (!controls || !counter || !previous || !next) return;

      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      let currentPage = Math.max(0, pages.findIndex((page) => !page.hidden));
      const showPage = (index: number) => {
        currentPage = Math.max(0, Math.min(index, pages.length - 1));
        pages.forEach((page, pageIndex) => { page.hidden = pageIndex !== currentPage; });
        counter.textContent = `${currentPage + 1}/${pages.length}`;
        previous.disabled = currentPage === 0;
        next.disabled = currentPage === pages.length - 1;
      };

      previous.addEventListener('click', () => showPage(currentPage - 1), { signal });
      next.addEventListener('click', () => showPage(currentPage + 1), { signal });
      showPage(currentPage);
      controls.hidden = false;
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get('sidebar-pager')) customElements.define('sidebar-pager', SidebarPager);
</script>

<style>
  /* about widget */
  .sidebar-about {
    border: 1px solid var(--dc-color-2);
    margin-bottom: 12px;
  }
  .my-info {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: start;
    gap: 12px;
    padding: 12px;
  }
  .info-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
  }
  .info-avatar-link {
    display: block;
    border-radius: 50%;
  }
  .info-avatar-link:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 3px;
  }
  .info-avatar {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
  }
  .info-name {
    font-size: var(--text-list-title);
    color: var(--dc-color-2);
    text-decoration: none;
  }
  .info-description {
    margin: 0;
    min-width: 0;
    color: #475467;
    font-size: var(--text-ui);
    line-height: var(--leading-body);
    overflow-wrap: anywhere;
  }
  .info-name:hover,
  .info-name:focus-visible {
    color: var(--dc-color-1);
    text-decoration: underline;
  }
  .info-name:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .social {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    min-height: 2.25rem;
    background-color: #f3f3f3;
  }

  /* batch styles */
  .sidebar-item {
    padding: 12px 12px;
    margin-bottom: 12px;
    border: 1px solid #ccc;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .sidebar-item-header {
    display: flex;
    align-items: center;
    padding-bottom: 4px;
    padding-left: 2px;
    border-bottom: 1px dashed #aaa;
  }
  .sidebar-item-header h2 {
    font-size: var(--text-ui);
    line-height: var(--leading-heading);
    margin: 0;
    font-weight: 700;
  }
  .sidebar-item-header a {
    color: #333;
    text-decoration: none;
  }
  .sidebar-item-header a:hover {
    color: var(--dc-color-2);
  }

  /* paginated sidebar widgets */
  sidebar-pager {
    display: block;
  }
  .sidebar-recent .sidebar-item-header,
  .sidebar-galleries .sidebar-item-header {
    justify-content: space-between;
    gap: 8px;
  }
  .sidebar-recent h2,
  .sidebar-galleries h2 {
    color: #333;
    font-size: var(--text-list-title);
  }
  .sidebar-pagination {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #333;
    font-size: var(--text-ui);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sidebar-pagination[hidden] {
    display: none;
  }
  .sidebar-pagination-buttons {
    display: flex;
  }
  .sidebar-pagination button {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--dc-color-2);
    background-color: var(--dc-color-3);
    color: #fff;
    cursor: pointer;
  }
  .sidebar-pagination button + button {
    border-left: 0;
  }
  .sidebar-pagination button:hover:not(:disabled) {
    background-color: var(--dc-color-1);
  }
  .sidebar-pagination button:focus-visible {
    position: relative;
    outline: 2px solid var(--dc-color-2);
    outline-offset: 2px;
  }
  .sidebar-pagination button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .sidebar-page {
    padding-top: 10px;
  }
  .recent-featured,
  .sidebar-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recent-featured {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 6px;
  }
  .recent-featured a {
    display: block;
  }
  .recent-featured :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid #d5dbea;
  }
  .recent-featured span {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    margin-top: 6px;
    font-weight: 600;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .sidebar-list li {
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr);
    align-items: center;
    column-gap: 4px;
  }
  .sidebar-list li::before {
    content: '';
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background-color: #475467;
  }
  .sidebar-list a {
    display: block;
    min-width: 0;
    padding: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sidebar-galleries .sidebar-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(var(--gallery-rows), auto);
    grid-auto-flow: column;
    column-gap: 10px;
  }
  .sidebar-recent a,
  .sidebar-galleries a {
    color: #333;
    text-decoration: none;
  }
  .sidebar-page a:visited {
    color: #75568b;
  }
  .sidebar-recent a:hover,
  .sidebar-recent a:focus-visible,
  .sidebar-galleries a:hover,
  .sidebar-galleries a:focus-visible {
    background-color: #eef0f7;
    text-decoration: underline;
  }
  .sidebar-recent a:focus-visible,
  .sidebar-galleries a:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 1px;
  }
  .sidebar-empty {
    margin: 0;
    color: #667085;
  }
</style>
