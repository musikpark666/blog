---
import type { CollectionEntry } from 'astro:content';

type Props = (
  | { gallery: CollectionEntry<'gallery'>; postCount: number; title?: never; href?: never }
  | { gallery?: never; postCount?: number; title: string; href: string }
);

const { gallery, postCount, title: customTitle, href: customHref } = Astro.props;
const title = gallery?.data.title ?? customTitle;
const href = gallery ? `/g/${gallery.id}/` : customHref;
const relatedSites = gallery?.data.relatedSites ?? [];
---

<header class="gallery-header">
  <h1>
    <a href={href}>
      <span class="gallery-title-name">{title}</span>
      <span class="gallery-title-kind">ギャラリー</span>
    </a>
    {postCount !== undefined && <small>({postCount}件)</small>}
  </h1>
  <div class="gallery-header-action">
    {relatedSites.length > 0 && (
      <details class="gallery-related-sites">
        <summary class="gallery-action" aria-label="関連サイト">関連<span class="related-sites-suffix">サイト</span></summary>
        <nav class="related-sites-panel" aria-label={`${title}の関連サイト`}>
          <ul role="list">
            {relatedSites.map(({ title, url, description }) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer">
                  <span aria-hidden="true"># </span>{title}
                  <span class="visually-hidden">（新しいタブで開く）</span>
                </a>
                {description && <p>{description}</p>}
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}
    <button class="gallery-action" type="button" data-open-site-guide aria-haspopup="dialog" aria-controls="site-guide">案内</button>
  </div>
</header>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    document.querySelectorAll<HTMLDetailsElement>('.gallery-related-sites[open]').forEach((panel) => {
      if (!panel.contains(event.target as Node)) panel.open = false;
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('.gallery-related-sites[open]').forEach((panel) => {
      panel.open = false;
      panel.querySelector('summary')?.focus({ preventScroll: true });
    });
  });
</script>

<style>
  .gallery-header {
    container: gallery-header / inline-size;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 2px solid var(--color-accent-border);
    gap: 2px;
    min-width: 0;
  }

  /* title */
  .gallery-header h1 {
    display: flex;
    align-items: baseline;
    margin: 0;
    padding-bottom: 3.25px;
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    min-width: 0;
  }
  .gallery-header  h1 a {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    height: 1lh;
    min-width: 0;
    color: var(--color-link);
    text-decoration: none;
    overflow: hidden;
  }
  .gallery-header h1 small {
    color: var(--color-muted);
    font-size: var(--text-small);
    font-weight: 400;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .gallery-title-name {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-title-kind {
    flex-shrink: 0;
    padding-left: 0.25em;
    white-space: nowrap;
  }
  .gallery-header h1 a:hover,
  .gallery-header h1 a:focus-visible {
    color: var(--color-link);
    outline: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* actions */
  .gallery-header-action {
    position: relative;
    display: flex;
    flex-shrink: 0;
  }
  .gallery-action {
    display: flex;
    align-items: center;
    border: 0;
    background-color: transparent;
    color: var(--color-secondary);
    min-height: 1.75rem;
    padding: 0.25em 0.375em;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    white-space: nowrap;
    cursor: pointer;
  }
  .gallery-header-action > * + * {
    position: relative;
    margin-left: 5px;
  }
  .gallery-header-action > * + *::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -3px;
    width: 1px;
    height: 10px;
    background-color: var(--color-border);
    transform: translateY(-50%);
    pointer-events: none;
  }
  .gallery-action:hover,
  .gallery-action:focus-visible,
  .gallery-related-sites[open] > summary {
    background: var(--color-selected);
    color: var(--color-link);
    outline: none;
  }

  .gallery-related-sites > summary {
    list-style: none;
  }
  .gallery-related-sites > summary::-webkit-details-marker {
    display: none;
  }
  @container gallery-header (width < 30rem) {
    .related-sites-suffix {
      display: none;
    }
  }
  .related-sites-panel {
    position: absolute;
    z-index: 5;
    top: calc(100% + 0.375rem);
    right: 0;
    width: min(24rem, calc(100vw - 24px - 8px));
    max-height: min(24rem, 60dvh);
    overflow-y: auto;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-accent-border);
    border-radius: 2px;
    background: var(--color-surface);
    box-shadow: 0 3px 10px var(--color-shadow);
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    overflow-wrap: anywhere;
  }
  .related-sites-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related-sites-panel li {
    padding-block: 0.5rem;
  }
  .related-sites-panel li + li {
    border-top: 1px solid var(--color-border);
  }
  .related-sites-panel a {
    color: var(--color-link);
    text-decoration: none;
    text-underline-offset: 3px;
  }
  .related-sites-panel a:hover {
    text-decoration: underline;
  }
  .related-sites-panel a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .related-sites-panel p {
    margin: 0.25em 0 0;
    color: var(--color-muted);
  }

</style>
