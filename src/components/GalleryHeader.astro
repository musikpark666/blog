---
import type { CollectionEntry } from 'astro:content';

type Props = { showInfo?: boolean } & (
  | { gallery: CollectionEntry<'gallery'>; postCount: number; title?: never; href?: never }
  | { gallery?: never; postCount?: never; title: string; href: string }
);

const { gallery, postCount, title: customTitle, href: customHref, showInfo = true } = Astro.props;
const title = gallery?.data.title ?? customTitle;
const href = gallery ? `/g/${gallery.id}/` : customHref;
---

<header class="gallery-header" data-gallery-header-root>
  <h1>
    <a href={href}>
      <span class="gallery-title-name">{title}</span>
      <span class="gallery-title-kind">ギャラリー</span>
    </a>
    {postCount !== undefined && <small>({postCount}件)</small>}
  </h1>
  <div class="gallery-header-action">
    {showInfo && <button type="button" aria-label="ギャラリー情報">ⓘ</button>}
    <button type="button">案内</button>
  </div>
</header>

<style>
  .gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 2px solid var(--dc-color-2);
    gap: 2px;
    min-width: 0;
  }

  /* title */
  .gallery-header h1 {
    display: flex;
    align-items: baseline;
    margin: 0;
    padding-bottom: 3.25px;
    font-size: var(--text-heading);
    line-height: var(--leading-heading);
    min-width: 0;
  }
  .gallery-header  h1 a {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    height: 1lh;
    min-width: 0;
    color: var(--dc-color-2);
    text-decoration: none;
    overflow: hidden;
  }
  .gallery-header h1 small {
    color: #667085; /* previously #98a2b3 */
    font-size: var(--text-small);
    font-weight: 400;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .gallery-title-name {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-title-kind {
    flex-shrink: 0;
    padding-left: 0.25em;
    white-space: nowrap;
  }
  .gallery-header h1 a:hover,
  .gallery-header h1 a:focus-visible {
    color: var(--dc-color-3);
    outline: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* actions */
  .gallery-header-action {
    display: flex;
    flex-shrink: 0;
  }
  .gallery-header-action button {
    border: 0;
    background-color: transparent;
    color: #475467;
    min-height: 1.75rem;
    padding: 0.25em 0.375em;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    white-space: nowrap;
    cursor: pointer;
  }
  .gallery-header-action button + button {
    position: relative;
    margin-left: 5px;
  }
  .gallery-header-action button + button::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -3px;
    width: 1px;
    height: 10px;
    background-color: #ccc;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .gallery-header-action button:hover,
  .gallery-header-action button:focus-visible {
    background: #f1f4ff;
    color: var(--dc-color-2);
    outline: none;
  }

</style>
