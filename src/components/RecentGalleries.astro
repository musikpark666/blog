<recent-galleries id="recent-galleries">
  <div class="recent-bar">
    <button type="button" class="recent-toggle" data-recent-toggle aria-expanded="false" aria-controls="recent-gallery-panel">最近の訪問 <span data-recent-arrow aria-hidden="true">▾</span></button>
    <button type="button" data-recent-scroll="-1" aria-label="最近の訪問を左へスクロール" disabled>‹</button>
    <div class="recent-strip" data-recent-strip>
      <ul data-recent-list role="list"></ul>
      <p data-recent-empty>訪問履歴はまだありません。</p>
    </div>
    <button type="button" data-recent-scroll="1" aria-label="最近の訪問を右へスクロール" disabled>›</button>
    <button type="button" data-recent-hide>非表示</button>
  </div>
  <section id="recent-gallery-panel" aria-label="最近訪れたギャラリー" hidden>
    <ul class="recent-grid" data-recent-list role="list"></ul>
    <p data-recent-empty>訪問履歴はまだありません。</p>
    <div class="recent-footer"><button type="button" data-recent-clear disabled>すべて削除</button></div>
  </section>
  <template data-recent-item>
    <li>
      <a><span data-recent-name></span><span data-recent-minor aria-label="マイナー" hidden>ⓜ</span></a>
      <button type="button" class="recent-remove" data-recent-remove>×</button>
    </li>
  </template>
</recent-galleries>

<script>
  interface RecentGallery { kind: 'g' | 'm'; id: string; title: string }
  const storageKey = 'musik.recent-galleries';
  const visibilityKey = 'musik.recent-galleries-hidden';
  const limit = 30;
  const keyOf = (entry: RecentGallery) => `${entry.kind}:${entry.id}`;

  function normalizeEntries(value: unknown): RecentGallery[] {
    if (!Array.isArray(value)) return [];
    const entries: RecentGallery[] = [];
    const seen = new Set<string>();
    for (const entry of value) {
      if (!entry || (entry.kind !== 'g' && entry.kind !== 'm') ||
        typeof entry.id !== 'string' || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(entry.id) || entry.id.length > 100 ||
        typeof entry.title !== 'string' || !entry.title.trim() || entry.title.length > 200) continue;
      const key = keyOf(entry);
      if (seen.has(key)) continue;
      seen.add(key);
      entries.push({ kind: entry.kind, id: entry.id, title: entry.title });
      if (entries.length === limit) break;
    }
    return entries;
  }

  function withVisit(entries: RecentGallery[], visit: RecentGallery) {
    return [visit, ...entries.filter((entry) => keyOf(entry) !== keyOf(visit))].slice(0, limit);
  }

  class RecentGalleries extends HTMLElement {
    private entries: RecentGallery[] = [];
    private controller?: AbortController;
    private observer?: ResizeObserver;

    connectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const strip = this.querySelector<HTMLElement>('[data-recent-strip]')!;
      const panel = this.querySelector<HTMLElement>('#recent-gallery-panel')!;
      const toggles = this.querySelectorAll<HTMLButtonElement>('[data-recent-toggle]');
      const setHidden = (hidden: boolean) => {
        document.documentElement.dataset.recentGalleriesHidden = String(hidden);
        try { localStorage.setItem(visibilityKey, String(hidden)); }
        catch { /* The current page still reflects the selection without storage. */ }
      };
      const setExpanded = (expanded: boolean) => {
        panel.hidden = !expanded;
        toggles.forEach((button) => button.setAttribute('aria-expanded', String(expanded)));
        this.querySelector('[data-recent-arrow]')!.textContent = expanded ? '▴' : '▾';
      };
      const sync = (record: boolean) => {
        try {
          document.documentElement.dataset.recentGalleriesHidden = String(localStorage.getItem(visibilityKey) === 'true');
          const raw = localStorage.getItem(storageKey);
          this.entries = normalizeEntries(raw && raw.length <= 32_000 ? JSON.parse(raw) : []);
        } catch { /* Retain this page's in-memory history when storage is unavailable. */ }
        if (record) {
          const current = document.querySelector<HTMLElement>('[data-visited-gallery]');
          const visit = normalizeEntries(current ? [{ kind: current.dataset.kind, id: current.dataset.id, title: current.dataset.title }] : [])[0];
          if (visit) {
            const next = withVisit(this.entries, visit);
            if (JSON.stringify(next) !== JSON.stringify(this.entries)) {
              this.entries = next;
              this.save();
            }
          }
        }
        this.render();
      };
      this.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>('button');
        if (!button) return;
        if (button.hasAttribute('data-recent-hide')) {
          setExpanded(false);
          setHidden(true);
          Array.from(document.querySelectorAll<HTMLButtonElement>('header [popovertarget="site-menu"]'))
            .find((control) => control.getClientRects().length > 0)?.focus({ preventScroll: true });
        }
        if (button.hasAttribute('data-recent-toggle')) setExpanded(panel.hidden);
        if (button.dataset.recentScroll) strip.scrollBy({
          left: Number(button.dataset.recentScroll) * strip.clientWidth * 0.8,
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
        });
        if (button.hasAttribute('data-recent-remove')) {
          const list = button.closest('ul')!;
          const index = [...list.children].indexOf(button.parentElement!);
          this.entries = this.entries.filter((entry) => keyOf(entry) !== button.dataset.recentRemove);
          this.save();
          this.render();
          const nextButton = list.children[Math.min(index, list.children.length - 1)]?.querySelector<HTMLButtonElement>('button');
          (nextButton ?? this.querySelector<HTMLButtonElement>('[data-recent-toggle]'))?.focus({ preventScroll: true });
        }
        if (button.hasAttribute('data-recent-clear')) {
          this.entries = [];
          this.save();
          this.render();
          this.querySelector<HTMLButtonElement>('[data-recent-toggle]')?.focus({ preventScroll: true });
        }
      }, { signal });
      document.querySelectorAll('[data-show-recent-galleries]').forEach((button) => button.addEventListener('click', () => {
        setHidden(false);
        document.getElementById('site-menu')?.hidePopover();
        this.querySelector<HTMLButtonElement>('[data-recent-toggle]')?.focus({ preventScroll: true });
      }, { signal }));
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          setExpanded(false);
          this.querySelector<HTMLButtonElement>('[data-recent-toggle]')?.focus({ preventScroll: true });
        }
      }, { signal });
      strip.addEventListener('scroll', () => this.syncScroll(), { passive: true, signal });
      this.observer = new ResizeObserver(() => this.syncScroll());
      this.observer.observe(strip);
      this.observer.observe(strip.querySelector('ul')!);
      window.addEventListener('pageshow', () => sync(false), { signal });
      window.addEventListener('storage', (event) => {
        if (event.key === storageKey || event.key === visibilityKey || event.key === null) sync(false);
      }, { signal });
      document.addEventListener('astro:page-load', () => sync(true), { signal });
      sync(true);
    }

    private save() {
      try { localStorage.setItem(storageKey, JSON.stringify(this.entries)); }
      catch { /* Reading and deleting the current list still work without persistence. */ }
    }

    private render() {
      const template = this.querySelector<HTMLTemplateElement>('[data-recent-item]')!;
      this.querySelectorAll('[data-recent-list]').forEach((list) => {
        const fragment = document.createDocumentFragment();
        for (const entry of this.entries) {
          const item = template.content.cloneNode(true) as DocumentFragment;
          const link = item.querySelector('a')!;
          link.href = `/${entry.kind}/${entry.id}/`;
          link.title = `${entry.title}${entry.kind === 'm' ? 'ⓜ' : ''}`;
          item.querySelector('[data-recent-name]')!.textContent = entry.title;
          item.querySelector<HTMLElement>('[data-recent-minor]')!.hidden = entry.kind !== 'm';
          const remove = item.querySelector<HTMLButtonElement>('[data-recent-remove]')!;
          remove.dataset.recentRemove = keyOf(entry);
          remove.setAttribute('aria-label', `${link.title}を訪問履歴から削除`);
          remove.title = '履歴から削除';
          fragment.append(item);
        }
        list.replaceChildren(fragment);
      });
      this.querySelectorAll<HTMLElement>('[data-recent-empty]').forEach((empty) => { empty.hidden = this.entries.length > 0; });
      this.querySelector<HTMLButtonElement>('[data-recent-clear]')!.disabled = this.entries.length === 0;
      this.syncScroll();
    }

    private syncScroll() {
      const strip = this.querySelector<HTMLElement>('[data-recent-strip]')!;
      this.querySelector<HTMLButtonElement>('[data-recent-scroll="-1"]')!.disabled = strip.scrollLeft <= 1;
      this.querySelector<HTMLButtonElement>('[data-recent-scroll="1"]')!.disabled = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 1;
    }

    disconnectedCallback() {
      this.controller?.abort();
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('recent-galleries')) customElements.define('recent-galleries', RecentGalleries);
</script>

<style>
  recent-galleries { display: block; max-width: var(--layout-max-width); margin-inline: auto; border: 1px solid var(--color-border); border-top: 0; background: var(--color-surface); color: var(--color-secondary); font-size: var(--text-small); line-height: var(--leading-ui); }
  :global(html[data-recent-galleries-hidden="true"]) recent-galleries { display: none; }
  [hidden] { display: none !important; }
  .recent-bar { display: flex; align-items: center; gap: 4px; min-width: 0; min-height: 2.25rem; padding: 2px 8px; background: var(--color-surface-muted); }
  button { flex-shrink: 0; border: 0; padding: 4px; background: transparent; color: var(--color-link); font: inherit; white-space: nowrap; cursor: pointer; }
  button:hover:not(:disabled) { background: var(--color-hover); }
  button:disabled { color: var(--color-disabled); cursor: default; }
  :is(a, button):focus-visible { outline: 2px solid var(--color-focus); outline-offset: -2px; }
  .recent-toggle { display: flex; align-items: center; gap: 6px; }
  [data-recent-arrow] { color: var(--color-muted); }
  [data-recent-scroll] { width: 20px; font-size: var(--text-ui); }
  .recent-strip { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  ul { margin: 0; padding: 0; list-style: none; }
  .recent-strip ul { display: flex; gap: 14px; width: max-content; }
  li { display: flex; align-items: center; gap: 3px; min-width: 0; }
  a { display: flex; align-items: baseline; min-width: 0; color: var(--color-secondary); text-decoration: none; }
  a:hover { color: var(--color-link); text-decoration: underline; text-underline-offset: 3px; }
  [data-recent-name] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .recent-strip [data-recent-name] { max-width: 10rem; }
  [data-recent-minor] { flex-shrink: 0; }
  .recent-remove { color: var(--color-muted); padding: 2px 4px; }
  .recent-remove:hover { color: var(--color-link); }
  #recent-gallery-panel { padding: 12px; border-top: 1px solid var(--color-border); }
  .recent-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(170px, 100%), 1fr)); gap: 4px 18px; max-height: min(20rem, 60dvh); overflow-y: auto; scrollbar-width: thin; }
  .recent-grid a { flex: 1; }
  p { margin: 0; padding: 4px; color: var(--color-muted); }
  .recent-strip p { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .recent-footer { display: flex; justify-content: flex-end; margin-top: 8px; }
  @media (max-width: 1100px) {
    recent-galleries { border-inline: 0; }
  }
  @media (max-width: 499px) {
    .recent-bar { gap: 2px; padding-inline: 4px; }
    .recent-strip ul { gap: 8px; }
    .recent-strip [data-recent-name] { max-width: 8rem; }
  }
</style>
