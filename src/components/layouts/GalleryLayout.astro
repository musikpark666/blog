---
import BaseLayout from './BaseLayout.astro';
import GalleryHeader from '../GalleryHeader.astro';
import GalleryPostList from '../GalleryPostList.astro';
import { Image } from 'astro:assets';
import { getGalleryHref, getGalleryKind, getGalleryPostHref, getPostListPageHref, type GalleryPageProps } from '../../lib/gallery';
interface Props extends GalleryPageProps {}
const { gallery, pagePosts, randomPosts, postCount, currentPage, totalPages, compactPage } = Astro.props;
const compactPageHref = compactPage.currentPage !== currentPage
  ? getPostListPageHref(getGalleryHref(gallery), compactPage.currentPage) : undefined;
const { title, description, thumbnail } = gallery.data;
const pageTitle = `${title} ギャラリー${getGalleryKind(gallery) === 'm' ? 'ⓜ' : ''} | musik.gallery`;
---

<BaseLayout title={pageTitle} description={description}>
  <span hidden data-visited-gallery data-kind={getGalleryKind(gallery)} data-id={gallery.id} data-title={title}></span>
  <GalleryHeader gallery={gallery} postCount={postCount} />

  <div class="gallery-intro">
    <div class:list={['gallery-intro-layout', { 'has-random-posts': randomPosts.length > 0 }]}>
      <div class="gallery-intro-info">
        {thumbnail && <Image src={thumbnail} alt="" width="150" height="100" fit="cover" />}
        <p>{description}</p>
      </div>
      {randomPosts.length > 0 && (
        <section class="gallery-random-posts" aria-label="ランダムな記事">
          <ul role="list">
            {randomPosts.map((post) => (
              <li>
                <a href={getGalleryPostHref(gallery, post.id)}>
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>

  <GalleryPostList 
    gallery={gallery}
    posts={pagePosts}
    currentPage={currentPage}
    totalPages={totalPages}
    compactPage={compactPage}
    compactPageHref={compactPageHref}
  />
</BaseLayout>

<style>
  /* Gallery Intro */
  .gallery-intro {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
    container: gallery-intro / inline-size;
  }
  .gallery-intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .gallery-intro-info {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    min-width: 0;
  }
  .gallery-intro-info :global(img) {
    flex-shrink: 0;
    max-width: 100%;
  }
  .gallery-intro-info p {
    margin: 0;
    color: var(--color-secondary);
    min-width: 0;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
    overflow-wrap: anywhere;
  }
  
  .gallery-random-posts {
    display: none;
    min-width: 0;
  }
  .gallery-random-posts ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-small);
  }
  .gallery-random-posts li {
    display: grid;
    grid-template-columns: 4px minmax(0, 1fr);
    align-items: center;
    column-gap: 4px;
  }
  .gallery-random-posts li::before {
    content: '';
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background-color: var(--color-secondary);
  }
  .gallery-random-posts a {
    display: block;
    min-width: 0;
    padding: 2px 4px;
    color: var(--color-secondary);
    line-height: var(--leading-ui);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-random-posts a:visited {
    color: var(--color-visited);
  }
  .gallery-random-posts a:hover,
  .gallery-random-posts a:focus-visible {
    background-color: var(--color-hover);
    text-decoration: underline;
  }
  .gallery-random-posts a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
  }

  @container gallery-intro (min-width: 600px) {
    .gallery-intro-layout.has-random-posts {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .gallery-random-posts {
      display: block;
    }
  }
</style>
