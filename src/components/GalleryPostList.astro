---
import type { CollectionEntry } from 'astro:content';
import GalleryPostListBody from './GalleryPostListBody.astro';
import type { GalleryPostPage } from '../lib/gallery';

interface Props {
  gallery?: CollectionEntry<'gallery'>;
  posts: CollectionEntry<'post'>[];
  currentPage?: number;
  totalPages?: number;
  currentPostId?: string;
  compactPage?: GalleryPostPage;
  compactPageHref?: string;
}
const { gallery, posts, currentPage = 1, totalPages = 1, currentPostId,
  compactPage, compactPageHref } = Astro.props;
---

<gallery-post-list class="gallery-posts" data-compact-page-href={compactPageHref}>

  <div class="post-list-header">
    <div class="post-list-group">
      <button type="button" aria-pressed="true">全体</button>
      <button type="button" aria-pressed="false">人気</button>
      <button type="button" aria-pressed="false">お知らせ</button>
    </div>
    <div class="post-list-group" role="group" aria-label="投稿一覧の表示形式">
      <button type="button" data-list-view-option="compact" aria-pressed="false">簡易</button>
      <button type="button" data-list-view-option="images" aria-pressed="true">画像</button>
    </div>
  </div>

  <GalleryPostListBody gallery={gallery} posts={posts} currentPage={currentPage} totalPages={totalPages} currentPostId={currentPostId} />
  {compactPage && <GalleryPostListBody gallery={gallery} posts={compactPage.pagePosts} currentPage={compactPage.currentPage} totalPages={compactPage.totalPages} currentPostId={currentPostId} view="compact" />}
</gallery-post-list>

<script>
  const storageKey = 'musik.post-list-view';
  const changeEvent = 'post-list-view-change';

  function applyView(view: 'compact' | 'images') {
    document.documentElement.dataset.postListView = view;
    document.dispatchEvent(new Event(changeEvent));
  }

  function restoreView() {
    try {
      const saved = localStorage.getItem(storageKey);
      applyView(saved === 'compact' ? 'compact' : 'images');
    } catch {
      // Keep this page's selection when browser storage is unavailable.
    }
  }

  class GalleryPostList extends HTMLElement {
    private controller?: AbortController;

    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const syncButtons = () => {
        const view = document.documentElement.dataset.postListView ?? 'images';
        this.querySelectorAll<HTMLButtonElement>('[data-list-view-option]').forEach((option) => {
          option.setAttribute('aria-pressed', String(option.dataset.listViewOption === view));
        });
        // A later image page can exceed the compact view's last page.
        const href = this.dataset.compactPageHref;
        if (view === 'compact' && href) {
          try {
            if (localStorage.getItem(storageKey) === 'compact') {
              location.replace(href + location.search + location.hash);
            }
          } catch { /* Keep the prepared final page visible if storage is blocked. */ }
        }
      };

      this.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>('[data-list-view-option]');
        const view = button?.dataset.listViewOption;
        if (view !== 'compact' && view !== 'images') return;
        try { localStorage.setItem(storageKey, view); }
        catch { /* Switching still works on this page when storage is blocked. */ }
        applyView(view);
      }, { signal });
      document.addEventListener(changeEvent, syncButtons, { signal });
      syncButtons();
    }

    disconnectedCallback() {
      this.controller?.abort();
    }
  }

  if (!customElements.get('gallery-post-list')) customElements.define('gallery-post-list', GalleryPostList);
  window.addEventListener('pageshow', restoreView);
  document.addEventListener('astro:page-load', restoreView);
  window.addEventListener('storage', (event) => {
    if (event.key === storageKey || event.key === null) restoreView();
  });

</script>

<style>
  .gallery-posts {
    display: block;
    margin-top: 10px;
    container: gallery-posts / inline-size;
  }

  /* post-list header toolbar */
  .post-list-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 4px;
  }
  .post-list-group {
    display: flex;
    gap: 3px;
  }

  .post-list-group button {
    padding: 0.25em 0.5em;
    min-height: 1.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-muted);
    color: var(--color-secondary);
    font: inherit;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    white-space: nowrap;
    cursor: pointer;
  }
  .post-list-group button[aria-pressed="true"]:not([data-list-view-option]),
  :global(html:not([data-post-list-view="compact"])) button[data-list-view-option="images"],
  :global(html[data-post-list-view="compact"]) button[data-list-view-option="compact"] {
    border-color: var(--color-accent-border);
    background-color: var(--color-brand);
    color: var(--color-on-brand);
    font-weight: 700; 
  }
  .post-list-group button:hover,
  .post-list-group button:focus-visible {
    border-color: var(--color-accent-border);
    color: var(--color-link);
    outline: none;
  }
  .post-list-group button[aria-pressed="true"]:not([data-list-view-option]):is(:hover, :focus-visible),
  :global(html:not([data-post-list-view="compact"])) button[data-list-view-option="images"]:is(:hover, :focus-visible),
  :global(html[data-post-list-view="compact"]) button[data-list-view-option="compact"]:is(:hover, :focus-visible) {
    color: var(--color-on-brand-hover);
  }


</style>
