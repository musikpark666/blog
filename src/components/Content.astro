---
import Sidebar from './Sidebar.astro';
---

<div class="content-wrapper">
  <div class="content-left">
    <slot name="left" />
  </div>
  <div class="content-main">
    <article>
      <slot />
    </article>
    <aside>
      <Sidebar />
    </aside>
  </div>
</div>

<style>
  .content-wrapper {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--layout-max-width)) minmax(0, 1fr);
    width: 100%;
    flex: 1;
  }

  .content-main {
    display: grid;
    grid-column: 2;
    grid-row: 1;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }

  aside {
    display: none;
  }

  article {
    padding: 12px 0 12px 12px;
    margin: 0 12px 0 0 ;
    min-width: 0;
  }

  .content-left {
    display: none;
  }

  @media (min-width: 768px) {
    .content-main {
      grid-template-columns: minmax(0, 1fr) calc(260px + 12px);
    }

    aside {
      display: block;
      padding: 12px 12px 12px 0;
    }
  }

  @media (min-width: 992px) { 
    .content-main {
      grid-template-columns: minmax(0, 1fr) calc(300px + 12px);
    }
  }

  /* 1100px main area plus 180px of space on each side. */
  @media (min-width: 1460px) {
    .content-left {
      display: block;
      grid-column: 1;
      grid-row: 1;
      width: var(--layout-left-width);
      max-width: 100%;
      min-width: 0;
      justify-self: end;
      position: sticky;
      top: 1rem;
      align-self: start;
    }
  }
</style>
