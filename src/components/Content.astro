---
import Sidebar from './Sidebar.astro';
---

<div class="content-wrapper">
  <div class="content-left">
    Left Side
  </div>
  <article>
    <slot />
  </article>
  <aside>
    <Sidebar />
  </aside>
</div>

<style>
  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    max-width: var(--layout-max-width);
    margin: 0 auto;
    width: 100%;
    flex: 1;
  }

  aside {
    display: none;
  }

  article {
    padding: 12px 0 12px 12px;
    margin: 0 12px 0 0 ;
    overflow: hidden;
  }

  .content-left {
    display: none;
  }

  @media (min-width: 768px) {
    .content-wrapper {
      grid-template-columns: var(--layout-left-width) 1fr calc(260px + 12px);
    }

    .content-left {
      display: block;  
      overflow: hidden;
    }

    aside {
      display: block;
      padding: 12px 12px 12px 0;
    }
  }

  @media (min-width: 992px) { 
    .content-wrapper {
      grid-template-columns: var(--layout-left-width) 1fr calc(300px + 12px);
    }
  }
</style>
