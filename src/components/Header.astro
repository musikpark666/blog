---
import { Image } from 'astro:assets';
import Navigation from '../components/Navigation.astro';
import TitleSVG from '../../public/brand-title.svg';
import brandLogo from '../assets/imgs/brand-logo-foiled.png';
import { themes } from '../lib/themes';
---

<header>
  <div class="header-container">
    <a class="header-brand" href="/" title="朴武識のブログ">
      <Image
        class="header-brand-logo"
        src={brandLogo}
        alt="blog logo"
        width={48}
        height={48}
        widths={[36, 48, 72, 96, 108, 144]}
        sizes="(min-width: 768px) 48px, 36px"
        format="avif"
        quality={70}
        loading="eager"
      />
      <TitleSVG class="header-brand-title" fill="currentColor" />
    </a>
    <div class="header-search">
      <button class="header-search-menu" type="button" popovertarget="site-menu" aria-label="メニュー">
     	  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/></svg>
      </button>
      <search>
        <form method="get" action="/search">
          <input 
            type="text"
            name="q"
            autocomplete="off"
            placeholder="ブログ統合検索"
            value=""
          />
          <button type="submit">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.796 15.811 21 21m-3-10.5a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0"/></svg>
          </button>
        </form>
      </search>
      <button class="header-search-resentpage">最近の訪問</button>
    </div>
    <ul class="header-menu">
      <li>
        <button class="header-menu-btn" type="button" popovertarget="site-menu" aria-label="メニュー">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
          </svg>
        </button>
      </li>
    </ul>
  </div>
  <Navigation />
</header>

<div id="site-menu" popover aria-labelledby="site-menu-title">
  <div class="menu-heading">
    <h2 id="site-menu-title">メニュー</h2>
    <button class="menu-close" type="button" popovertarget="site-menu" popovertargetaction="hide" aria-label="メニューを閉じる">×</button>
  </div>
  <fieldset class="theme-picker">
    <legend>表示テーマ</legend>
    {themes.map((theme) => (
      <label class="theme-option">
        <input type="radio" name="site-theme" value={theme.id} data-theme-choice checked={theme.id === 'light'} />
        <span><strong>{theme.label}</strong><small>{theme.description}</small></span>
      </label>
    ))}
  </fieldset>
  <nav class="menu-links" aria-label="サイトメニュー">
    <a href="/about/">このブログについて <span aria-hidden="true">↗</span></a>
    <button type="button" data-open-site-guide aria-haspopup="dialog" aria-controls="site-guide">サイトのご案内 <span aria-hidden="true">↗</span></button>
    <a href="/all/">すべての投稿 <span aria-hidden="true">↗</span></a>
  </nav>
  <section class="menu-planned" aria-labelledby="menu-planned-title">
    <h3 id="menu-planned-title">これから</h3>
    <ul>
      <li>ランダム記事 <small>準備中</small></li>
      <li>最近見た記事 <small>準備中</small></li>
      <li>RSSを購読 <small>準備中</small></li>
    </ul>
  </section>
</div>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('#site-menu a[href], #site-menu [data-open-site-guide]')) {
      document.getElementById('site-menu')?.hidePopover();
    }
  });
</script>

<style>
  header {
    background-color: var(--color-brand);
  }
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  /* Header Brand */
  .header-brand {
    display: flex;
    align-items: center;
    height: 36px;
    margin: 8px 4px;
  }
  .header-brand-logo {
    height: 100%;
    width: auto;
  }
  .header-brand-title {
    display: none;
  }

  /* Header Search */
  .header-search {
    display: flex;
    align-items: center;
    height: 2.25rem;
    width: 100%;
    min-width: 0;
    margin: 8px 8px 8px 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-accent-border);
  }
  .header-search button {
    padding: 0;
    border: 0 none;
    background: transparent;
    cursor: pointer;
  }

  .header-search search {
    height: 100%;
    width: 100%;
    min-width: 0;
  }
  .header-search form {
    display: flex;
    height: 100%;
  }
  .header-search form input {
    width: 100%;
    min-width: 0;
    padding: 0 6px;
    border: none;
    outline: none;
    background: transparent;
    color: inherit;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .header-search form button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-link);
    width: 30px;
    flex-shrink: 0;
  }
  .header-search input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .header-search-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 34px;
    border-right: 1px solid var(--color-border) !important;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .header-search-resentpage {
    display: flex;
    align-items: center;
    padding: 0 6px !important;
    height: 100%;
    color: var(--color-muted);
    flex-shrink: 0;
    font-weight: 700;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    white-space: nowrap;
    position: relative;
  }
  .header-search-resentpage::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 1.25rem;
    background-color: var(--color-border);
  }

  /* Header Menu */
  .header-menu {
    display: none;
  }
  /* Header Hover and Focus */
  .header-brand:hover,
  .header-brand:focus {
    background-color: var(--color-brand-soft);
  }
  .header-brand:focus-visible {
    outline: 2px solid var(--color-on-brand-hover);
    outline-offset: -2px;
  }

  .header-search button:hover,
  .header-search button:focus,
  .header-search form input:focus {
    background-color: var(--color-hover);
    color: var(--color-link-hover);
  }

  /* Header Queries */
  @media (min-width: 500px) {
    .header-brand-title {
      display: block;
      height: 50%;
      width: auto;
      color: var(--color-on-brand);
    }
  }

  @media (min-width: 768px) {
    header {
      background-color: var(--color-surface);
    }
    .header-container {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) minmax(0, 420px) minmax(max-content, 1fr);
      min-height: 4.75rem;
    }

    .header-brand {
      justify-self: start;
      height: 48px;
      margin: 0px 8px 0px 4px;
    }
    .header-brand:hover,
    .header-brand:focus {
      background-color: var(--color-hover);
    }
    .header-brand:focus-visible {
      outline-color: var(--color-focus);
    }
    .header-brand-logo {
      height: 48px;
    }
    .header-brand-title {
      color: var(--color-text);
      height: 21px;
    }

    .header-search {
      height: 2.875rem;
      margin: auto 0;
      border: 4px solid var(--color-accent-border);
    }
    .header-search form input {
      padding: 0 8px;
    }
    .header-search form button {
      background-color: var(--color-brand-soft);
      color: var(--color-on-brand);
      width: 40px;
      padding-left: 4px;
    }
    .header-search form button svg {
      height: 28px;
      width: 28px;
    }
    .header-search form button svg path {
      stroke-width: 2.5;
    }
    .header-search form button:hover,
    .header-search form button:focus {
      background-color: var(--color-brand);
    }

    .header-search-menu,
    .header-search-resentpage {
      display: none;
    }

    .header-menu {
      justify-self: end;
      align-self: center;
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      min-width: 0;
      margin: 0 4px;
      padding: 0;
      gap: 8px;
      color: var(--color-muted);
      font-size: var(--text-small);
      line-height: var(--leading-ui);
      list-style: none;
    }
    .header-menu li {
      display: flex;
      align-items: center;
    }
    .header-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 1px solid var(--color-accent-border);
      border-radius: 2px;
      background-color: var(--color-brand-soft);
      color: var(--color-on-brand);
      cursor: pointer;
    }
    .header-menu-btn:hover {
      border-color: var(--color-accent-border);
      background-color: var(--color-brand);
    }
    .header-menu-btn:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
  }

  /* Native popover supplies outside-click dismissal and Escape handling. */
  #site-menu {
    position: fixed;
    inset: 60px 12px auto auto;
    width: min(320px, calc(100vw - 24px));
    max-height: calc(100dvh - 84px);
    overflow-y: auto;
    margin: 0;
    padding: 14px;
    border: 1px solid var(--color-accent-border);
    border-radius: 3px;
    background: var(--color-overlay);
    color: var(--color-text-soft);
    box-shadow: 0 6px 24px var(--color-shadow);
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .menu-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .menu-heading h2 { margin: 0; color: var(--color-heading); font-size: var(--text-list-title); }
  .menu-close { width: 28px; height: 28px; padding: 0; border: 0; background: transparent; color: inherit; font-size: var(--text-heading); cursor: pointer; }
  .theme-picker { margin: 0; padding: 0 0 12px; border: 0; }
  .theme-picker legend, .menu-planned h3 { margin: 0 0 6px; padding: 0; color: var(--color-muted); font-size: var(--text-small); font-weight: 400; }
  .theme-option { display: flex; gap: 10px; align-items: center; padding: 7px 8px; border: 1px solid transparent; border-radius: 2px; cursor: pointer; }
  .theme-option:has(input:checked) { border-color: var(--color-border); background: var(--color-selected); }
  .theme-option input { margin: 0; accent-color: var(--color-link); }
  .theme-option strong { display: block; font-weight: 500; color: var(--color-heading); }
  .theme-option small { display: block; color: var(--color-muted); font-size: var(--text-small); }
  .theme-option:has(input:checked) small { color: var(--color-secondary); }
  .menu-links { display: grid; padding-block: 8px; border-block: 1px solid var(--color-border); }
  .menu-links a, .menu-links button { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 8px; border: 0; background: transparent; color: var(--color-link); font: inherit; text-decoration: none; text-align: start; cursor: pointer; }
  .menu-links span { color: var(--color-muted); }
  .theme-option:hover, .menu-links a:hover, .menu-links button:hover, .menu-close:hover { background: var(--color-hover); }
  .menu-links :is(a, button):focus-visible, .menu-close:focus-visible, .theme-option:has(input:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 1px; }
  .menu-planned { padding: 12px 8px 2px; }
  .menu-planned ul { margin: 0; padding: 0; list-style: none; }
  .menu-planned li { display: flex; justify-content: space-between; gap: 8px; padding-block: 4px; color: var(--color-muted); }
  .menu-planned small { font-size: var(--text-small); }
  @media (min-width: 768px) {
    #site-menu { top: 64px; right: max(12px, calc((100vw - var(--layout-max-width)) / 2 + 4px)); }
  }
</style>
