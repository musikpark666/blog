---
import { Image } from 'astro:assets';
import Navigation from '../components/Navigation.astro';
import TitleSVG from '../../public/brand-title.svg';
import brandLogo from '../assets/imgs/brand-logo-foiled.png';
---

<header>
  <div class="header-container">
    <a class="header-brand" href="/" title="朴武識のブログ">
      <Image
        class="header-brand-logo"
        src={brandLogo}
        alt="blog logo"
        width={48}
        height={48}
        widths={[36, 48, 72, 96, 108, 144]}
        sizes="(min-width: 768px) 48px, 36px"
        format="avif"
        quality={70}
        loading="eager"
      />
      <TitleSVG class="header-brand-title" fill="currentColor" />
    </a>
    <div class="header-search">
      <button class="header-search-menu">
     	  <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/></svg>
      </button>
      <search>
        <form method="get" action="/search">
          <input 
            type="text"
            name="q"
            autocomplete="off"
            placeholder="ブログ統合検索"
            value=""
          />
          <button type="submit">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.796 15.811 21 21m-3-10.5a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0"/></svg>
          </button>
        </form>
      </search>
      <button class="header-search-resentpage">最近の訪問</button>
    </div>
    <ul class="header-menu">
      <li>
        <button class="header-menu-nightmode" type="button" data-theme-toggle aria-label="夜間モードに切り替え">
          <span class="theme-label-light">🌙夜間モード</span><span class="theme-label-dark">☀️通常モード</span>
        </button>
      </li>
      <li>
        <button class="header-menu-btn" type="button" aria-label="メニュー">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
          </svg>
        </button>
      </li>
    </ul>
  </div>
  <Navigation />
</header>

<style>
  header {
    background-color: var(--color-brand);
  }
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    max-width: var(--layout-max-width);
    margin: 0 auto;
  }

  /* Header Brand */
  .header-brand {
    display: flex;
    align-items: center;
    height: 36px;
    margin: 8px 4px;
  }
  .header-brand-logo {
    height: 100%;
    width: auto;
  }
  .header-brand-title {
    display: none;
  }

  /* Header Search */
  .header-search {
    display: flex;
    align-items: center;
    height: 2.25rem;
    width: 100%;
    min-width: 0;
    margin: 8px 8px 8px 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-accent-border);
  }
  .header-search button {
    padding: 0;
    border: 0 none;
    background: transparent;
    cursor: pointer;
  }

  .header-search search {
    height: 100%;
    width: 100%;
    min-width: 0;
  }
  .header-search form {
    display: flex;
    height: 100%;
  }
  .header-search form input {
    width: 100%;
    min-width: 0;
    padding: 0 6px;
    border: none;
    outline: none;
    background: transparent;
    color: inherit;
    font-size: var(--text-ui);
    line-height: var(--leading-ui);
  }
  .header-search form button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-link);
    width: 30px;
    flex-shrink: 0;
  }
  .header-search input::placeholder {
    color: var(--color-muted);
    opacity: 1;
  }

  .header-search-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 34px;
    border-right: 1px solid var(--color-border) !important;
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .header-search-resentpage {
    display: flex;
    align-items: center;
    padding: 0 6px !important;
    height: 100%;
    color: var(--color-muted);
    flex-shrink: 0;
    font-weight: 700;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
    white-space: nowrap;
    position: relative;
  }
  .header-search-resentpage::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 1.25rem;
    background-color: var(--color-border);
  }

  /* Header Menu */
  .header-menu {
    display: none;
  }
  .header-menu-nightmode {
    padding: 4px 2px;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .header-menu-nightmode:hover { color: var(--color-link); }
  .header-menu-nightmode:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* Header Hover and Focus */
  .header-brand:hover,
  .header-brand:focus {
    background-color: var(--color-brand-soft);
  }
  .header-brand:focus-visible {
    outline: 2px solid var(--color-on-brand-hover);
    outline-offset: -2px;
  }

  .header-search button:hover,
  .header-search button:focus,
  .header-search form input:focus {
    background-color: var(--color-hover);
    color: var(--color-link-hover);
  }

  /* Header Queries */
  @media (min-width: 500px) {
    .header-brand-title {
      display: block;
      height: 50%;
      width: auto;
      color: var(--color-on-brand);
    }
  }

  @media (min-width: 768px) {
    header {
      background-color: var(--color-surface);
    }
    .header-container {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) minmax(0, 420px) minmax(max-content, 1fr);
      min-height: 4.75rem;
    }

    .header-brand {
      justify-self: start;
      height: 48px;
      margin: 0px 8px 0px 4px;
    }
    .header-brand:hover,
    .header-brand:focus {
      background-color: var(--color-hover);
    }
    .header-brand:focus-visible {
      outline-color: var(--color-focus);
    }
    .header-brand-logo {
      height: 48px;
    }
    .header-brand-title {
      color: var(--color-text);
      height: 21px;
    }

    .header-search {
      height: 2.875rem;
      margin: auto 0;
      border: 4px solid var(--color-accent-border);
    }
    .header-search form input {
      padding: 0 8px;
    }
    .header-search form button {
      background-color: var(--color-brand-soft);
      color: var(--color-on-brand);
      width: 40px;
      padding-left: 4px;
    }
    .header-search form button svg {
      height: 28px;
      width: 28px;
    }
    .header-search form button svg path {
      stroke-width: 2.5;
    }
    .header-search form button:hover,
    .header-search form button:focus {
      background-color: var(--color-brand);
    }

    .header-search-menu,
    .header-search-resentpage {
      display: none;
    }

    .header-menu {
      justify-self: end;
      align-self: center;
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      min-width: 0;
      margin: 0 4px;
      padding: 0;
      gap: 8px;
      color: var(--color-muted);
      font-size: var(--text-small);
      line-height: var(--leading-ui);
      list-style: none;
    }
    .header-menu li {
      display: flex;
      align-items: center;
    }
    .header-menu-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      padding: 0;
      border: 1px solid var(--color-accent-border);
      border-radius: 2px;
      background-color: var(--color-brand-soft);
      color: var(--color-on-brand);
      cursor: pointer;
    }
    .header-menu-btn:hover {
      border-color: var(--color-accent-border);
      background-color: var(--color-brand);
    }
    .header-menu-btn:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 2px;
    }
  }

</style>
