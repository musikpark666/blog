    max-width: none;
    max-height: calc(100dvh - 24px - 180px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--dc-color-2);
    border-radius: 2px;
    background: #fff;
    color: #475467;
    box-shadow: 0 12px 40px #171b3033;
    font-size: var(--text-ui);
    line-height: var(--leading-body);
  }
  dialog[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 40%);
  }
  .guide-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.375rem 0.25rem 1rem;
    background: var(--dc-color-3);
    color: #fff;
  }
  h2 {
    margin: 0;
    font-size: var(--text-ui);
    line-height: var(--leading-heading);
  }
  h2:focus {
    outline: none;
  }
  button {
    cursor: pointer;
    font: inherit;
  }
  .guide-close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }
  .guide-close:hover {
    background: rgb(255 255 255 / 15%);
  }
  .guide-close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -4px;
  }
  .guide-body {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem;
    overflow-wrap: anywhere;
  }
  .guide-body > p {
    margin: 0;
  }
  section {
    margin-top: 1.5rem;
  }
  h3 {
    margin: 0 0 0.5rem;
    color: #171b30;
    font-size: inherit;
  }
  section p {
    margin: 0.5rem 0 0;
  }
  a {
    color: var(--dc-color-2);
    text-underline-offset: 3px;
  }
  a:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: 2px;
  }
</style>
