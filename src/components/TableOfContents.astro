---
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  headings: MarkdownHeading[];
  compact?: boolean;
}

const { title, headings, compact = false } = Astro.props;
const Container = compact ? 'details' : 'div';
const hasSections = headings.some(({ depth }) => depth === 2);
---

{headings.length > 0 && (
  <Container class:list={['toc', { 'toc-compact': compact }]}>
    {compact ? (
      <summary>
        <a href="#post-title" title={title}>{title}</a>
      </summary>
    ) : (
      <p class="toc-title"><a href="#post-title">{title}</a></p>
    )}
    <nav aria-label="目次">
      <ul>
        {headings.map(({ depth, slug, text }) => (
          <li class:list={{ 'toc-subheading': hasSections && depth === 3 }}>
            <a href={`#${slug}`}>{text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
)}

<script>
  let cleanupTracking = () => {};

  function trackCurrentHeading() {
    cleanupTracking();

    const linksById = new Map<string, HTMLAnchorElement[]>();
    document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((link) => {
      link.removeAttribute('aria-current');
      const id = link.getAttribute('href')!.slice(1);
      const links = linksById.get(id) ?? [];
      links.push(link);
      linksById.set(id, links);
    });

    const headings = Array.from(document.querySelectorAll<HTMLElement>(
      '#post-title, .post-content h2[id], .post-content h3[id]'
    )).filter((heading) => linksById.has(heading.id));
    if (headings.length === 0) return;

    const events = new AbortController();
    let frame = 0;
    let currentId = '';

    function updateCurrentHeading() {
      frame = 0;
      const readingLine = (parseFloat(getComputedStyle(headings[0]).scrollMarginTop) || 64) + 1;

      // Find the last heading above the reading line, even between long sections.
      let start = 0;
      let end = headings.length;
      while (start < end) {
        const middle = Math.floor((start + end) / 2);
        if (headings[middle].getBoundingClientRect().top <= readingLine) {
          start = middle + 1;
        } else {
          end = middle;
        }
      }

      // The final section may be too close to the page end to reach the reading line.
      const atBottom = window.scrollY > 0 &&
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1;
      const id = headings[atBottom ? headings.length - 1 : Math.max(0, start - 1)].id;
      if (id === currentId) return;
      linksById.get(currentId)?.forEach((link) => link.removeAttribute('aria-current'));
      linksById.get(id)?.forEach((link) => link.setAttribute('aria-current', 'location'));
      currentId = id;
    }

    function scheduleUpdate() {
      if (!events.signal.aborted && !frame) frame = requestAnimationFrame(updateCurrentHeading);
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal: events.signal });
    window.addEventListener('resize', scheduleUpdate, { signal: events.signal });
    window.addEventListener('hashchange', scheduleUpdate, { signal: events.signal });
    const layoutObserver = new ResizeObserver(scheduleUpdate);
    layoutObserver.observe(document.body);

    cleanupTracking = () => {
      events.abort();
      layoutObserver.disconnect();
      cancelAnimationFrame(frame);
    };
    scheduleUpdate();
  }

  trackCurrentHeading();
  document.addEventListener('astro:page-load', trackCurrentHeading);
  document.addEventListener('astro:before-swap', () => cleanupTracking());

  // Close the compact panel before the browser follows the heading anchor.
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('.toc-compact a');
    if (!link || (event instanceof MouseEvent && (
      event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey
    ))) return;
    const panel = link.closest<HTMLDetailsElement>('details');
    if (panel) panel.open = false;
  });
</script>

<style>
  .toc {
    display: none;
    color: #475467;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
  }

  .toc-title {
    margin: 0 0 0.5rem;
    color: #171b30;
    font-size: var(--text-ui);
    font-weight: 600;
  }

  nav {
    overflow-y: auto;
    max-height: calc(100dvh - 5rem);
    scrollbar-width: thin;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 0.375rem 0.5rem;
    border-inline-start: 2px solid transparent;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .toc-subheading a {
    padding-inline-start: 1rem;
  }

  a:hover,
  a:focus-visible {
    border-inline-start-color: var(--dc-color-2);
    background-color: #f0f2f8;
    color: var(--dc-color-2);
  }

  a[aria-current="location"] {
    border-inline-start-color: var(--dc-color-2);
    background-color: #e8ecf8;
    color: var(--dc-color-2);
    font-weight: 600;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: -2px;
  }

  .toc-compact {
    display: block;
    position: relative;
    border: 1px solid #dfe2ee;
    background-color: #fff;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    color: var(--dc-color-2);
    font-size: var(--text-ui);
    font-weight: 600;
    cursor: pointer;
  }

  summary::before {
    content: '▸';
    flex-shrink: 0;
  }

  .toc-compact[open] summary::before {
    content: '▾';
  }

  summary a {
    min-width: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  summary:hover,
  summary:focus-visible {
    background-color: #f0f2f8;
  }

  .toc-compact nav {
    position: absolute;
    inset-inline: -1px;
    top: 100%;
    max-height: 45dvh;
    padding: 0.25rem;
    border: 1px solid #dfe2ee;
    background-color: #fff;
  }

  @media (min-width: 1200px) {
    .toc {
      display: block;
      padding: 0.75rem 0.5rem;
    }

    .toc-compact {
      display: none;
    }
  }
</style>
