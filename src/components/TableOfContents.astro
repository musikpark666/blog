---
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  headings: MarkdownHeading[];
  compact?: boolean;
}

const { title, headings, compact = false } = Astro.props;
const Container = compact ? 'details' : 'div';
const hasSections = headings.some(({ depth }) => depth === 2);
---

{headings.length > 0 && (
  <div class:list={['toc', { 'toc-compact': compact }]}>
    {!compact && <p class="toc-title"><a href="#post-title" title={title}>{title}</a></p>}
    <Container class:list={{ 'toc-panel': compact }}>
      {compact && (
        <summary aria-label="目次を開閉" title="目次">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="4" cy="6" r="1" fill="currentColor" stroke="none" />
            <circle cx="4" cy="12" r="1" fill="currentColor" stroke="none" />
            <circle cx="4" cy="18" r="1" fill="currentColor" stroke="none" />
            <path d="M9 6h11M9 12h11M9 18h11" />
          </svg>
        </summary>
      )}
      <nav aria-label="目次">
        <ul>
          {compact && <li class="toc-post-title"><a href="#post-title">{title}</a></li>}
          {headings.map(({ depth, slug, text }) => (
            <li class:list={{ 'toc-subheading': hasSections && depth === 3 }}>
              <a href={`#${slug}`}>{text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </Container>
  </div>
)}

<script>
  let cleanupTracking = () => {};

  function trackCurrentHeading() {
    cleanupTracking();

    const linksById = new Map<string, HTMLAnchorElement[]>();
    document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]').forEach((link) => {
      link.removeAttribute('aria-current');
      const id = link.getAttribute('href')!.slice(1);
      const links = linksById.get(id) ?? [];
      links.push(link);
      linksById.set(id, links);
    });

    const allHeadings = Array.from(document.querySelectorAll<HTMLElement>(
      '#post-title, .post-content h2[id], .post-content h3[id]'
    )).filter((heading) => linksById.has(heading.id));
    if (allHeadings.length === 0) return;

    const events = new AbortController();
    let frame = 0;
    let currentId = '';
    let headings = allHeadings;
    let readingLine = 65;
    let needsRefresh = true;
    const switchMargin = 12;

    function setCurrentHeading(id: string) {
      if (!linksById.has(id) || id === currentId) return;
      linksById.get(currentId)?.forEach((link) => link.removeAttribute('aria-current'));
      linksById.get(id)?.forEach((link) => link.setAttribute('aria-current', 'location'));
      currentId = id;
    }

    function selectLinkedHeading(hash: string) {
      try {
        const id = decodeURIComponent(hash.slice(1));
        const heading = allHeadings.find((heading) => heading.id === id);
        if (!heading) return;
        // Open all folded ancestors before native fragment navigation.
        for (let parent = heading.parentElement; parent; parent = parent.parentElement) {
          if (parent instanceof HTMLDetailsElement) parent.open = true;
        }
        setCurrentHeading(id);
      } catch {
        // Ignore malformed URL fragments and continue tracking scroll position.
      }
    }

    function updateCurrentHeading() {
      frame = 0;
      if (needsRefresh) {
        // Visibility and the reading line only need refreshing after layout or details changes.
        headings = allHeadings.filter((heading) =>
          !heading.closest('details:not([open]) > :not(summary)')
        );
        readingLine = headings.length > 0
          ? (parseFloat(getComputedStyle(headings[0]).scrollMarginTop) || 64) + 1
          : 65;
        needsRefresh = false;
      }
      if (headings.length === 0) return;
      const currentIndex = headings.findIndex((heading) => heading.id === currentId);

      // Find the last heading above the reading line, even between long sections.
      let start = 0;
      let end = headings.length;
      while (start < end) {
        const middle = Math.floor((start + end) / 2);
        if (headings[middle].getBoundingClientRect().top <= readingLine) {
          start = middle + 1;
        } else {
          end = middle;
        }
      }

      // The final section may be too close to the page end to reach the reading line.
      const atBottom = window.scrollY > 0 &&
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 1;
      let index = atBottom ? headings.length - 1 : Math.max(0, start - 1);
      if (!atBottom && currentIndex >= 0) {
        // Use different thresholds in each direction to avoid flickering at a boundary.
        while (index > currentIndex && headings[index].getBoundingClientRect().top > readingLine - switchMargin) index--;
        while (index < currentIndex && headings[index + 1].getBoundingClientRect().top <= readingLine + switchMargin) index++;
      }
      setCurrentHeading(headings[index].id);
    }

    function scheduleUpdate() {
      if (!events.signal.aborted && !frame) frame = requestAnimationFrame(updateCurrentHeading);
    }

    function refreshTracking() {
      needsRefresh = true;
      scheduleUpdate();
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal: events.signal });
    window.addEventListener('resize', refreshTracking, { signal: events.signal });
    document.addEventListener('toggle', refreshTracking, { capture: true, signal: events.signal });
    window.addEventListener('hashchange', () => {
      selectLinkedHeading(window.location.hash);
      scheduleUpdate();
    }, { signal: events.signal });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || event.defaultPrevented ||
        event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const openPanel = document.querySelector<HTMLDetailsElement>('.toc-compact .toc-panel[open]');
      if (openPanel && !openPanel.contains(event.target)) openPanel.open = false;
      const link = event.target.closest<HTMLAnchorElement>('.toc a[href^="#"]');
      if (!link) return;
      selectLinkedHeading(link.hash);
      scheduleUpdate();
    }, { signal: events.signal });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const panel = document.querySelector<HTMLDetailsElement>('.toc-compact .toc-panel[open]');
      if (!panel) return;
      panel.open = false;
      panel.querySelector('summary')?.focus({ preventScroll: true });
    }, { signal: events.signal });
    const layoutObserver = new ResizeObserver(refreshTracking);
    layoutObserver.observe(document.body);

    cleanupTracking = () => {
      events.abort();
      layoutObserver.disconnect();
      cancelAnimationFrame(frame);
    };
    selectLinkedHeading(window.location.hash);
    scheduleUpdate();
  }

  trackCurrentHeading();
  document.addEventListener('astro:page-load', trackCurrentHeading);
  document.addEventListener('astro:before-swap', () => cleanupTracking());

</script>

<style>
  .toc {
    display: none;
    color: #475467;
    font-size: var(--text-small);
    line-height: var(--leading-ui);
  }

  .toc-title {
    margin: 0 0 0.5rem;
    color: #171b30;
    font-size: var(--text-ui);
    font-weight: 600;
  }

  nav {
    overflow-y: auto;
    max-height: calc(100dvh - 5rem);
    scrollbar-width: thin;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 0.375rem 0.5rem;
    border-inline-start: 2px solid transparent;
    color: inherit;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease;
  }

  .toc-subheading a {
    padding-inline-start: 1rem;
  }

  a:hover,
  a:focus-visible {
    border-inline-start-color: var(--dc-color-2);
    background-color: #f0f2f8;
    color: var(--dc-color-2);
  }

  a[aria-current="location"] {
    border-inline-start-color: var(--dc-color-2);
    background-color: #e8ecf8;
    color: var(--dc-color-2);
    font-weight: 600;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--dc-color-2);
    outline-offset: -2px;
  }

  .toc-compact {
    display: block;
    position: relative;
    border: 1px solid #cfd4e4;
    border-radius: 3px;
    background: #fff;
    box-shadow: 0 2px 8px #171b3026;
  }

  summary {
    display: grid;
    place-items: center;
    width: var(--button-size, 2.75rem);
    height: var(--button-size, 2.75rem);
    padding: 0;
    border-radius: 2px;
    background: transparent;
    color: var(--dc-color-2);
    font-size: var(--text-small);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toc-post-title {
    margin-block-end: 0.25rem;
    padding-block-end: 0.25rem;
    border-bottom: 1px solid #e1e4ec;
    color: #171b30;
    font-size: var(--text-ui);
    font-weight: 600;
  }

  .toc-panel[open] summary,
  summary:hover,
  summary:focus-visible {
    background-color: #f0f2f8;
  }

  .toc-compact nav {
    position: absolute;
    inset-inline-end: 0;
    bottom: calc(100% + 0.5rem);
    width: min(20rem, calc(100vw - 40px));
    max-height: min(60dvh, calc(100dvh - 12rem));
    overscroll-behavior: contain;
    padding: 0.375rem;
    border: 1px solid #dfe2ee;
    border-radius: 3px;
    background-color: rgb(255 255 255 / 94%);
    box-shadow: 0 2px 8px #171b3026;
  }

  @media (min-width: 1460px) {
    .toc {
      display: block;
      padding: 0.75rem 0.5rem;
    }

    .toc-compact {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
